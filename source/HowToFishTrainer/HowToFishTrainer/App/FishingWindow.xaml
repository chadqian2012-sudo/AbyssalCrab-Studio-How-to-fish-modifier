<Window x:Class="HowToFishTrainer.App.FishingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AbyssalCrab Studio · 钓鱼手记" Width="1080" Height="820" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{DynamicResource GlassCanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Margin" Value="0,0,8,10"/><Setter Property="Padding" Value="20,10"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}" CornerRadius="12" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1"><TextBlock x:Name="HeaderText" Text="{TemplateBinding Header}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="HeaderText" Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="WrappedDisplay"><TextBlock Text="{Binding Display}" TextWrapping="Wrap" ToolTip="{Binding Display}"/></DataTemplate>
    <Style x:Key="JournalCard" TargetType="Border" BasedOn="{StaticResource FeatureCardStyle}"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  </Window.Resources>
  <Border Background="{DynamicResource GlassCanvasBrush}"><Grid Margin="24,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="钓鱼手记" Style="{StaticResource H1}"/><TextBlock Text="日志 · 图鉴 · 回顾 · 存档" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="20,0,0,0"/></DockPanel>
    <Border Grid.Row="1" Style="{StaticResource JournalCard}" Padding="14,10">
      <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding ActiveSessionText}" ToolTip="{Binding ActiveSessionText}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <TextBox Grid.Column="1" Text="{Binding SessionName,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" ToolTip="新场次名称" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Content="开始本局" Command="{Binding BeginSessionCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/>
        <Button Grid.Column="3" Content="结束并回顾" Click="Finish_Click" IsEnabled="{Binding CanEdit}"/>
      </Grid>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="2">
      <TabItem Header="钓鱼日志">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource JournalCard}"><StackPanel IsEnabled="{Binding CanEdit}">
            <TextBlock Text="补记鱼获" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="填写真实钓获；重量为每条 kg，同批数量会按单条重量计算。未知重量留空。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="鱼种 / 自定义名称" Style="{StaticResource FieldLabel}"/><ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding SpeciesNames}" Text="{Binding SpeciesText,UpdateSourceTrigger=PropertyChanged}" ToolTip="可选择已知鱼种或输入自定义鱼种"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="数量（整数）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CountInput.Text,UpdateSourceTrigger=PropertyChanged}" MaxLength="8" ToolTip="1–10000"/><TextBlock Text="{Binding CountInput.Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="10"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="单条重量 kg（可空）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding WeightText,UpdateSourceTrigger=PropertyChanged}" MaxLength="24" ToolTip="支持小数；不强制修改输入"/><TextBlock Text="{Binding WeightError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="10"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="钓获时间" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CatchTime,UpdateSourceTrigger=PropertyChanged}" MaxLength="16" ToolTip="yyyy-MM-dd HH:mm"/></StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="地点" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Place,UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="装备 / 鱼饵" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Equipment,UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/></StackPanel>
            </Grid>
            <TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" Height="58" VerticalScrollBarVisibility="Auto"/>
            <Button Content="记入当前进行中的场次" Command="{Binding AddCatchCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource JournalCard}"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Display" ToolTip="查看某一局的鱼获" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="筛选鱼种、地点、装备或备注"/></Grid>
            <ListBox ItemsSource="{Binding Catches}" SelectedItem="{Binding SelectedCatch}" ItemTemplate="{StaticResource WrappedDisplay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{StaticResource OptionListBox}" Height="180" Margin="0,12,0,10"/>
            <WrapPanel><Button Content="导出全部日志 CSV" Click="ExportAll_Click" Margin="0,0,8,0"/><Button Content="删除选中记录" Click="DeleteCatch_Click" IsEnabled="{Binding CanEdit}"/></WrapPanel>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="鱼类图鉴">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Border Style="{StaticResource JournalCard}"><StackPanel>
            <TextBlock Text="{Binding PersonalStats}" TextWrapping="Wrap"/>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" ToolTip="选择账号" Margin="0,0,10,0" IsEnabled="{Binding CanEdit}"/><TextBox Grid.Column="1" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索鱼种" Margin="0,0,10,0"/><Button Grid.Column="2" Content="刷新存档图鉴" Command="{Binding RefreshCodexCommand}"/></Grid>
            <TextBlock Text="{Binding CodexStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel></Border>
          <Border Grid.Row="1" Style="{StaticResource JournalCard}"><ListBox ItemsSource="{Binding Codex}" ItemTemplate="{StaticResource WrappedDisplay}" Style="{StaticResource OptionListBox}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Border>
        </Grid>
      </TabItem>
      <TabItem Header="每局回顾">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Display" Margin="0,0,0,12"/>
          <Border Style="{StaticResource JournalCard}"><TextBlock x:Name="RecapText" Text="{Binding Summary}" TextWrapping="Wrap" FontSize="15" LineHeight="26"/></Border>
          <WrapPanel><Button Content="导出本局 CSV" Click="ExportSession_Click" Margin="0,0,8,0"/><Button Content="保存回顾图片" Click="ExportImage_Click"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="存档备份">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource JournalCard}"><StackPanel>
            <TextBlock Text="游戏存档目录" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="备份覆盖所有账号下的 .txt 和 .txt.backup；读取的是已落盘数据。恢复前需完全退出游戏。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,10"/>
            <TextBlock Text="{Binding SaveRoot}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <WrapPanel IsEnabled="{Binding CanEdit}"><Button Content="选择存档目录" Click="ChooseRoot_Click" Margin="0,0,8,8"/><Button Content="立即创建备份" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><CheckBox Content="自动备份（10 分钟检测）" IsChecked="{Binding AutoBackup}" VerticalAlignment="Center" Margin="8,0,0,8"/></WrapPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource JournalCard}"><StackPanel>
            <DockPanel><Button Content="刷新列表" Command="{Binding RefreshBackupsCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="已有备份" Style="{StaticResource SectionTitle}"/></DockPanel>
            <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" ItemTemplate="{StaticResource WrappedDisplay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{StaticResource OptionListBox}" Height="220" Margin="0,12,0,12"/>
            <Button Content="校验并恢复所选备份…" Click="Restore_Click" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding BackupStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" CornerRadius="10" Background="{DynamicResource GlassChromeBrush}" Padding="12,9" Margin="0,8,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"/></Border>
  </Grid></Border>
</Window>
