<UserControl x:Class="HowToFishTrainer.App.CombatFeedbackPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App">
  <Border Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18" Margin="0,0,8,12" DataContext="{Binding CombatFeedback}">
    <StackPanel>
      <DockPanel><TextBlock Text="连杀热潮与战斗反馈" Style="{StaticResource SectionTitle}"/><Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right"><TextBlock Text="3 · 热身   5 · 狂潮   10 · 深渊暴走" FontSize="10" Foreground="{StaticResource AccentDarkBrush}"/></Border></DockPanel>
      <TextBlock Text="以房主实际扣血为依据；连杀热度随间隔衰减。结束、断线或紧急停用后停止。" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <WrapPanel><CheckBox Content="连杀热度与播报" IsChecked="{Binding Streaks}" Margin="0,0,18,10"/><CheckBox Content="命中与击败标记" IsChecked="{Binding Markers}" Margin="0,0,18,10"/><CheckBox Content="实际伤害飘字" IsChecked="{Binding Numbers}" Margin="0,0,18,10"/><CheckBox Content="爆头提示音" IsChecked="{Binding HeadSound}" Margin="0,0,18,10"/><CheckBox Content="击败提示音" IsChecked="{Binding KillSound}" Margin="0,0,18,10"/><CheckBox Content="武器散布指示" IsChecked="{Binding DynamicCrosshair}" Margin="0,0,0,10"/></WrapPanel>
      <UniformGrid Columns="4" Margin="0,2,0,12"><StackPanel Margin="0,0,12,0"><TextBlock Text="连杀间隔 / 秒" Style="{StaticResource Muted}" Margin="0,0,0,5"/><app:NumericInputBox Input="{Binding ComboWindowInput}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="音量 / 0–1" Style="{StaticResource Muted}" Margin="0,0,0,5"/><app:NumericInputBox Input="{Binding VolumeInput}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="透明度 / 0.1–1" Style="{StaticResource Muted}" Margin="0,0,0,5"/><app:NumericInputBox Input="{Binding OpacityInput}"/></StackPanel><StackPanel><TextBlock Text="大小 / 0.5–2" Style="{StaticResource Muted}" Margin="0,0,0,5"/><app:NumericInputBox Input="{Binding ScaleInput}"/></StackPanel></UniformGrid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource AccentDarkBrush}" FontSize="11" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="开启 / 应用" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Margin="0,0,8,0"/><Button Content="停止反馈" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/></StackPanel></Grid>
      <Expander Header="反馈说明" Margin="0,10,0,0"><TextBlock Text="仅对本机命中生物的已确认扣血反馈；实际伤害按 HP 减少值显示。高射速同目标合并飘字，最多同时 24 条；散布指示读取当前武器的真实散布角。连杀改变提示与热度，不写入角色属性。" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></Expander>
    </StackPanel>
  </Border>
</UserControl>
