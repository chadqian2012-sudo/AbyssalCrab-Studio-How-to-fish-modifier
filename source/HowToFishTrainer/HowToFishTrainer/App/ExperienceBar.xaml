<UserControl x:Class="HowToFishTrainer.App.ExperienceBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App">
  <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,9,8,12">
    <Expander>
      <Expander.Header>
        <DockPanel LastChildFill="False">
          <TextBlock Text="预设与快捷入口" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
          <TextBlock Text="展开管理参数方案、搜索功能和状态组件" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
        </DockPanel>
      </Expander.Header>
      <StackPanel Margin="0,10,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" ToolTip="选择已保存的参数方案" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" Text="{Binding PresetName,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" ToolTip="新预设名称；同名保存会更新该方案"/>
          <Button Grid.Column="2" Content="保存当前" Command="{Binding SavePresetCommand}" Margin="8,0,0,0"/>
          <Button Grid.Column="3" Content="恢复参数" Command="{Binding ApplyPresetCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
          <Button Grid.Column="4" Content="删除方案" Command="{Binding DeletePresetCommand}" Margin="8,0,0,0"/>
        </Grid>
        <Grid Margin="0,9,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchHit}" Text="{Binding FeatureQuery,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Title" ToolTip="搜索功能名称、说明、分类或功能 ID；选择结果定位分类"/>
          <CheckBox Grid.Column="1" Margin="18,0" Content="游戏状态组件" IsChecked="{Binding WidgetVisible}" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="2" Content="收起分类栏" IsChecked="{Binding CompactNavigation}" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="{Binding ExperienceStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/>
      </StackPanel>
    </Expander>
  </Border>
</UserControl>
