              <EventTrigger RoutedEvent="Binding.TargetUpdated">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.995" To="1" FillBehavior="Stop"
                                     Duration="{StaticResource MotionPage}" EasingFunction="{StaticResource EaseEnter}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.995" To="1" FillBehavior="Stop"
                                     Duration="{StaticResource MotionPage}" EasingFunction="{StaticResource EaseEnter}"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Grid.Triggers>
            <Grid.Tag>
              <Binding Path="PageTitle" NotifyOnTargetUpdated="True"/>
            </Grid.Tag>
