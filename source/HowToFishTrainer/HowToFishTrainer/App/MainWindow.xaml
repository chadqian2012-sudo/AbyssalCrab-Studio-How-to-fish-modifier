<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App" xmlns:core="clr-namespace:HowToFishTrainer.Core;assembly=HowToFishTrainer.Core" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="HowToFishTrainer.App.MainWindow" Title="{x:Static app:ProductIdentity.ProductName}" Icon="Assets/Brand/abyssalcrab-app-icon.png" Width="1460" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource BgBrush}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="{StaticResource RadiusWindow}" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/HowToFishTrainer;component/HowToFishTrainer/App/FeatureTemplates.xaml"/></ResourceDictionary.MergedDictionaries>
      <!-- 内容裁剪跟随当前内容层宽高；每次转换产生独享几何，四角均参与裁剪。
           最大化时仍由下面的触发器取消裁剪，恢复窗口后绑定自动接回。 -->
      <app:WindowClipConverter x:Key="WindowClipConverter"/>

      <!-- 外壳拆成两个兄弟层：装饰层（材质 + 高程落影，无子元素）与内容层（承载全部文字）。
           为什么必须拆：DropShadowEffect 会把整棵子树烘到中间表面，使文字从 ClearType 亚像素抗锯齿
           降级为灰度抗锯齿。外壳是所有文字的祖先，外壳一旦挂 Effect，整个应用都失去文字清晰度。
           把 Effect 只留在无子元素的装饰层上，就没有任何含文字的子树拥有带 Effect 的祖先。 -->
      <!-- 装饰层样式：只承载材质圆角与高程落影，自身无子元素。
           外边距 12 与 theme.xaml 的 GlassShadowWindow 反推一致（BlurRadius 9 的落影在 12 DIP 处
           剩余 alpha 已低于 0.01），所以不会被窗口边缘硬裁出可见硬边。 -->
      <Style x:Key="RoundedWindowSurface" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Effect" Value="{DynamicResource GlassShadowWindow}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}" Value="Maximized">
            <!-- 最大化：外边距归零 + 去掉高程落影，并把圆角一并复位。 -->
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect" Value="{x:Null}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- 内容层样式：无 Effect、无 BorderBrush，透明底，只保留圆角与裁切（圆角外不露方角底色）。
           主容器圆角取 RadiusContainer(20)，比窗口圆角(22)略紧一档。
           WindowState 触发器与装饰层同步复位，最大化时全出血、方角，与改动前一致。 -->
      <Style x:Key="RoundedWindowContent" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="UIElement.Clip">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource WindowClipConverter}" ConverterParameter="{StaticResource RadiusWindowSize}" Mode="OneWay">
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth"/>
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight"/>
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}" Value="Maximized">
            <!-- 最大化：外边距归零 + 圆角归零 + 撤掉裁切。 -->
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="UIElement.Clip" Value="{x:Null}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- 失焦态：工具层（顶栏/导航带）的材质遮罩。只叠一层不透明度层，不写死任何画刷颜色，
           所以不会和材质档切换打架；时长走 MotionStatus，减少动画档下自动归零。 -->

      <!-- 失焦态：外壳边缘的柔化层。与外层面板同边距、同圆角（直接绑定 ShellSurface），
           只是一圈 1px 底衬色的不透明度层——把边线往背景色上"洗"淡，而不是加粗边线。 -->
      <Style x:Key="ShellEdgeScrim" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource BgBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
            <DataTrigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.55"
                                   Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}"/>
                </Storyboard>
              </BeginStoryboard>
            </DataTrigger.EnterActions>
            <DataTrigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                   Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}"/>
                </Storyboard>
              </BeginStoryboard>
            </DataTrigger.ExitActions>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ToolbarSoundToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource GlassCardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeChromeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="54"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentLineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
  <!-- 外层 Grid 只做窗口底衬的承载：Window 的 Background="{StaticResource BgBrush}" 已经铺满整个客户区，
       所以这一层可以完全透明，不需要 Background（窗口外圈 12 DIP 的"底衬环"就是它露出来的部分）。
       两个兄弟层：装饰层（材质 + 高程落影，无子元素）在下，内容层（承载全部文字）在上。 -->
  <Border x:Name="ShellSurface" Style="{StaticResource RoundedWindowSurface}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" Background="{DynamicResource GlassCanvasBrush}" IsHitTestVisible="False"/>
  <!-- 内容层：透明底、无边框、无 Effect；3 行网格（64 / * / 38）整体搬进这里，内部结构未改。 -->
  <Border Style="{StaticResource RoundedWindowContent}" Background="Transparent">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition/>
        <RowDefinition Height="38"/>
      </Grid.RowDefinitions>

      <!-- ===================================================================
           玻璃底层（第 0 层）：独立于所有内容的背景画布。
           整层 IsHitTestVisible=False，只是装饰，不参与命中，不会挡按钮/滚动条/文本选择。
           两枚极低饱和光晕靠右上与左下摆放，避开正文所在的中部区域；正文另有实色料卡
           （GlassCardBrush）压在上面，所以不吃可读性。
           刻意不使用 AllowsTransparency，也不对整窗挂 BlurEffect —— 那会连文字一起糊。
           =================================================================== -->
      <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
        <Ellipse Width="760" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-260,-200,0" Fill="{DynamicResource GlassHaloAccentBrush}" />
        <Ellipse Width="620" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-180,0,0,-240" Fill="{DynamicResource GlassHaloWarmBrush}" />
      </Grid>

      <!-- 顶栏是"浮动工具层"：挂一层极淡的 GlassShadowChrome，让它明显压在导航带/内容之上，而不是与它们齐平。
           但 DropShadowEffect 会把整棵子树烘到中间表面，使文字从 ClearType 亚像素抗锯齿降级为灰度抗锯齿。
           所以把「材质 + 阴影」与「文字内容」拆成兄弟层：装饰层只承载 Background/Effect 且不参与命中，
           内容层保持无 Effect，顶栏与导航带这两条最常读的文字行的清晰度得以保住。 -->
      <Border Background="{DynamicResource GlassChromeBrush}" Effect="{DynamicResource GlassShadowChrome}" IsHitTestVisible="False"/>
      <!-- 顶边镜面高光：贴着外壳顶内沿的 1px 光带（GlassSpecularBrush 是"面"不是描边）。
           压在背景画布与工具层材质之上、顶栏内容之下；不参与命中，也不占布局高度。 -->
      <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
              Background="{DynamicResource GlassSpecularBrush}"/>
      <!-- 失焦遮罩：位于顶栏内容之下，只柔化材质，不压暗任何文字/按钮。 -->
      <Border Style="{StaticResource InactiveScrim}"/>
      <!-- 内容层：透明底 + 底边线。整条顶栏仍可命中（透明背景可命中），
           TitleBar_MouseLeftButtonDown 覆盖整行；装饰层 IsHitTestVisible=False 不会吞点击。 -->
      <Border Background="Transparent" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
              <Image Source="Assets/Brand/abyssalcrab-app-icon.png" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static app:ProductIdentity.ProductName}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="HOW TO FISH TRAINER" Style="{StaticResource Caption}" FontSize="9" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid Column="1" Margin="20,0,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="188"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <!-- 页标题与副标题都允许省略，但必须带 ToolTip：交接文档 §14 要求
                   「顶栏与页脚的详细状态允许省略 + Tooltip」。标题在窄窗口下是会被压的
                   （1180 宽时只有约 278 DIP 可用），没有 ToolTip 就会出现读不全又看不到全文的情况。 -->
              <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PageTitle}"/>
              <TextBlock Text="实时内存控制 · 结果由游戏内运行时确认" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="实时内存控制 · 结果由游戏内运行时确认"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessLineBrush}" BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="10,0,0,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" MaxWidth="150" TextTrimming="CharacterEllipsis" Text="{Binding ConnectionStatus}" ToolTip="{Binding ConnectionStatus}"/>
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding ModeStatus}" ToolTip="{Binding ModeStatus}"/>
          </Grid>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ToggleButton Content="音效" Style="{StaticResource ToolbarSoundToggle}" ToolTip="基础开关成功开启提示音" Margin="0,0,8,0" IsChecked="{Binding SoundEnabled}"/>
            <!-- 材质强度：纯外观设置，三档切换后立即整站生效并持久化到独立的 ui-appearance.json。
                 默认「着色玻璃」（交接文档 §7.3 要求偏可读）；低渲染能力时会被自动压到实色档。
                 必须放在 WindowChrome 的命中区里，否则 WindowStyle=None 下点不到。 -->
            <Menu Background="Transparent" BorderThickness="0" Margin="0,0,6,0" VerticalAlignment="Center">
              <MenuItem x:Name="MaterialMenu" Header="材质" Padding="10,5"
                        ToolTip="玻璃材质强度：实色 / 着色玻璃（默认）/ 通透。纯外观设置，不影响任何功能。">
                <MenuItem x:Name="MaterialSolidItem" Header="实色（可读性最高）" IsCheckable="True" Click="MaterialSolid_Click"/>
                <MenuItem x:Name="MaterialTintedItem" Header="着色玻璃（默认）" IsCheckable="True" Click="MaterialTinted_Click"/>
                <MenuItem x:Name="MaterialClearItem" Header="通透（玻璃感最强）" IsCheckable="True" Click="MaterialClear_Click"/>
              </MenuItem>
            </Menu>
            <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="最小化"/>
            <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="最大化"/>
            <Button x:Name="CloseButton" Content="×" Style="{StaticResource WindowButton}" Foreground="{StaticResource DangerBrush}" Click="Close_Click" ToolTip="隐藏到托盘，已开启功能继续运行；右键托盘图标可退出"/>
          </StackPanel>
        </Grid>
      </Border>
      <app:TrainerContentView x:Name="TrainerContent" Grid.Row="1"/>
      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,0">
        <Grid>
          <!-- 左段用 * 列 + 省略号：原来左段是 HorizontalAlignment 为默认（撑满整行）的
               StackPanel，而 ModeStatus 既没有 TextTrimming 也没有 ToolTip，文案一长就会直接
               压进右段的快捷键提示（右段是同一格里 Right 对齐，两者会重叠）。
               改成「星号列 + Auto 列」后左段最多只能用到右段左边的空间，不会再重叠。 -->
          <!-- 列宽策略：右段（紧急停用快捷键）是**安全关键**信息，交接文档 §7.2/§14 要求
               「紧急停用入口不能过小」、关键提示不能被省略得看不懂，所以它拿 Auto 宽度、
               永不截断；左段（模式状态）放 * 列，空间不足时由它省略，并且有完整 ToolTip。
               背景：上一版是反过来的（左 * 右 Auto 但右段带 TextTrimming），实测右段仍被截掉
               16 DIP —— 安全提示不该是第一个被牺牲的。 -->
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" Text="{Binding ModeStatus}" ToolTip="{Binding ModeStatus}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Margin="16,0,0,0" Text="紧急停用全部持续功能：Ctrl + Shift + F12"
                     Style="{StaticResource Muted}" FontSize="10"
                     TextWrapping="NoWrap" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
  <!-- 失焦时柔化外壳边线：与外层面板同边距/同圆角（直接绑定 ShellSurface），
       只叠一圈 1px 底衬色的不透明度层，不加粗边线、不改布局、不参与命中。 -->
  <Border Style="{StaticResource ShellEdgeScrim}"
          Margin="{Binding Margin, ElementName=ShellSurface}"
          CornerRadius="{Binding CornerRadius, ElementName=ShellSurface}"/>
  </Grid>
</Window>
