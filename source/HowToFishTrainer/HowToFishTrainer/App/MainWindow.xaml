                          <CheckBox Content="使用游戏原版赔率" VerticalAlignment="Center" IsChecked="{Binding FunEventsPage.Roulette.UseOriginalMultiplier}"/>
                          <app:NumericInputBox Grid.Column="1" Margin="7,0,0,0" Input="{Binding FunEventsPage.Roulette.MultiplierInput}" IsEnabled="{Binding FunEventsPage.Roulette.CanEditMultiplier}"/>
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,0,4" Text="{Binding FunEventsPage.Roulette.MultiplierStatusLabel}"/>
                        <Button Content="✦  应用轮盘控制" Style="{StaticResource PrimaryButton}" Padding="16,8" Command="{Binding FunEventsPage.Roulette.ApplyCommand}" IsEnabled="{Binding FunEventsPage.Roulette.CanConfigure}"/>
                      </StackPanel>
                    </Grid>
                    <Border Grid.Row="3" Background="{StaticResource AccentWashBrush}" CornerRadius="7" Padding="9,6" Margin="0,9,0,0">
                      <TextBlock Foreground="{StaticResource AccentDarkBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Text="{Binding FunEventsPage.Roulette.Status}"/>
                    </Border>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ScrollViewer}">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsCatalogPage}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding IsFunEventsPage}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding IsEntertainmentPage}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding IsRoomMembersPage}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <StackPanel>
                <app:FeelPanel Visibility="{Binding HasFeelFeatures,Converter={StaticResource BoolToVisibility}}"/>
                <Border Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18" Margin="0,0,8,12" Visibility="{Binding IsCombatPage,Converter={StaticResource BoolToVisibility}}">
                  <StackPanel><DockPanel><TextBlock Text="战斗诊断" FontSize="17" FontWeight="SemiBold"/><CheckBox DockPanel.Dock="Right" Content="仅观察诊断" IsChecked="{Binding DiagnosticOnly}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding CombatDiagnostics}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" Style="{StaticResource Muted}"/><TextBlock Text="观察模式暂停辅助瞄准与魔法子弹；取消后需手动开启。诊断只读取已发布的运行时状态。" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="10" Style="{StaticResource Muted}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18" Margin="0,0,8,14" Visibility="{Binding IsTeleportPage, Converter={StaticResource BoolToVisibility}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="280"/>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="245"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="保存的坐标" FontSize="16" FontWeight="SemiBold"/>
                      <ComboBox Margin="0,11,10,0" ToolTip="按分组筛选" ItemsSource="{Binding TeleportGroups}" SelectedItem="{Binding SelectedTeleportGroup}"/>
                      <TextBox Margin="0,7,10,0" ToolTip="搜索名称或分组" Text="{Binding TeleportPointQuery, UpdateSourceTrigger=PropertyChanged}"/>
                      <ComboBox ItemsSource="{Binding PointSortModes}" SelectedItem="{Binding PointSort}" Margin="0,7,10,0" ToolTip="坐标排序"/>
                      <ListBox Height="162" Margin="0,8,10,0" Style="{StaticResource OptionListBox}" BorderBrush="{StaticResource LineBrush}" ItemsSource="{Binding FilteredTeleportPoints}" SelectedItem="{Binding SelectedTeleportPoint}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="5">
                              <TextBlock FontWeight="SemiBold"><TextBlock.Text><MultiBinding Converter="{StaticResource PointDecorationConverter}" ConverterParameter="title"><Binding/><Binding Path="DataContext.PointMetadataRevision" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text><TextBlock.Foreground><MultiBinding Converter="{StaticResource PointDecorationConverter}" ConverterParameter="brush"><Binding/><Binding Path="DataContext.PointMetadataRevision" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Foreground></TextBlock>
                              <TextBlock Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding Converter="{StaticResource PointDecorationConverter}" ConverterParameter="note"><Binding/><Binding Path="DataContext.PointMetadataRevision" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0">
                      <TextBlock Text="当前 / 目标坐标" FontSize="16" FontWeight="SemiBold"/>
                      <CheckBox Content="房主操作选中房间成员" Margin="0,10,0,5" IsChecked="{Binding TargetRoomMember}" IsEnabled="{Binding CanTargetRoomMember}"/>
                      <ComboBox DisplayMemberPath="DisplayName" ToolTip="好友房玩家只能传送自己；房主可选择在线成员" ItemsSource="{Binding RoomMembersPage.Members}" SelectedItem="{Binding SelectedTeleportMember}" IsEnabled="{Binding TargetRoomMember}"/>
                      <UniformGrid Columns="3" Margin="0,11,0,8">
                        <app:NumericInputBox Margin="0,0,5,0" Input="{Binding CurrentXInput}"/>
                        <app:NumericInputBox Margin="5,0" Input="{Binding CurrentYInput}"/>
                        <app:NumericInputBox Margin="5,0,0,0" Input="{Binding CurrentZInput}"/>
                      </UniformGrid>
                      <CheckBox Content="安全落点校正（推荐）" Margin="0,2,0,7" IsChecked="{Binding SafeLanding}"/>
                      <UniformGrid Columns="2">
                        <Button Margin="0,4,4,4" Content="读取目标位置" Command="{Binding ReadPositionCommand}"/>
                        <Button Margin="4" Content="安全传送到目标" Style="{StaticResource PrimaryButton}" Command="{Binding TeleportSelectedCommand}"/>
                      </UniformGrid>
                      <Button Margin="0,4" Content="返回该目标上一次位置" Command="{Binding ReturnPreviousCommand}"/>
                      <UniformGrid Columns="2"><Button Content="记录安全位置" Command="{Binding RememberSafePositionCommand}" Margin="0,4,4,4"/><Button Content="填入安全位置" Command="{Binding SelectSafePositionCommand}" Margin="4"/></UniformGrid>
                      <CheckBox Content="自动记录死亡前位置（本机）" IsChecked="{Binding TrackDeathPosition}" Margin="0,7,0,0"/>
                      <Button Content="填入死亡前位置" Command="{Binding SelectDeathPositionCommand}" Margin="0,7,0,0"/>
                      <TextBlock Text="{Binding DeathPositionStatus}" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                      <TextBlock Margin="2,8" Style="{StaticResource Muted}" FontSize="10" Text="{Binding PositionStatus}"/>
                      <Border Name="IslandSelector" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,8,0,0">
                        <StackPanel>
                          <TextBlock Text="载入岛屿" FontWeight="SemiBold"/>
                          <TextBox Margin="0,8,0,6" ToolTip="搜索中文名、原名、目录键或场景序号" Text="{Binding IslandQuery, UpdateSourceTrigger=PropertyChanged}"/>
                          <ComboBox DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" ItemsSource="{Binding FilteredIslandOptions}" SelectedItem="{Binding SelectedIsland}" ToolTip="{Binding SelectedIsland.RawName}"/>
                          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="9" Text="{Binding SelectedIsland.Reason}"/>
                          <Button Margin="0,8,0,0" Content="载入选中岛屿" Style="{StaticResource PrimaryButton}" Command="{Binding LoadSelectedIslandCommand}" IsEnabled="{Binding CanLoadSelectedIsland}"/>
                          <TextBlock Margin="0,6,0,0" Style="{StaticResource Muted}" FontSize="10" Text="{Binding IslandStatus}"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                      <TextBlock Text="添加 / 编辑" FontSize="16" FontWeight="SemiBold"/>
                      <TextBox Margin="0,11,0,6" ToolTip="分组" Text="{Binding PointGroup, UpdateSourceTrigger=PropertyChanged}"/>
                      <TextBox Margin="0,0,0,8" ToolTip="坐标名称" Text="{Binding PointName, UpdateSourceTrigger=PropertyChanged}"/>
                      <Button Content="保存当前坐标" Style="{StaticResource PrimaryButton}" Command="{Binding SavePointCommand}"/>
                      <Button Margin="0,7,0,0" Content="删除选中坐标" Style="{StaticResource DangerButton}" Command="{Binding DeletePointCommand}"/>
                      <TextBlock Text="标记与备注" FontWeight="SemiBold" Margin="0,14,0,7"/>
                      <UniformGrid Columns="2"><ComboBox ItemsSource="{Binding PointColors}" SelectedItem="{Binding PointColor}" ToolTip="标记颜色" Margin="0,0,4,0"/><ComboBox ItemsSource="{Binding PointIcons}" SelectedItem="{Binding PointIcon}" ToolTip="图标" Margin="4,0,0,0"/></UniformGrid>
                      <TextBox Text="{Binding PointNote,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="500" Height="65" Margin="0,7,0,0" ToolTip="备注（可搜索，最多500字）"/>
                      <CheckBox Content="收藏此传送点" IsChecked="{Binding PointFavorite}" Margin="0,7,0,0"/>
                      <Button Content="保存标记与备注" Command="{Binding SavePointDetailsCommand}" Margin="0,7,0,0"/>
                      <UniformGrid Columns="2" Margin="0,10,0,0"><Button Content="导入坐标" Click="ImportTeleport_Click" Margin="0,0,4,0"/><Button Content="导出坐标" Click="ExportTeleport_Click" Margin="4,0,0,0"/></UniformGrid>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18" Margin="0,0,0,12" Visibility="{Binding IsCombatPage, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel DataContext="{Binding Crosshair}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌖  外置准星" FontSize="17" FontWeight="SemiBold"/>
                        <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="8" Padding="7,2" Margin="10,0,0,0">
                          <TextBlock Text="本机显示" Foreground="{StaticResource SuccessBrush}" FontSize="10"/>
                        </Border>
                      </StackPanel>
                      <CheckBox Grid.Column="1" Content="启用准星" VerticalAlignment="Center" IsChecked="{Binding Enabled}"/>
                    </Grid>
                    <Grid Margin="0,14,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="样式" Style="{StaticResource Caption}"/>
                        <ComboBox Margin="0,5,0,0" ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="颜色" Style="{StaticResource Caption}"/>
                        <ComboBox Margin="0,5,0,0" ItemsSource="{Binding Colors}" SelectedItem="{Binding Color}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="大小 6–36" Style="{StaticResource Caption}"/>
                        <Slider Minimum="6" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,0" Value="{Binding Size}"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Foreground="{StaticResource AccentDarkBrush}" FontSize="11" TextWrapping="Wrap" Text="{Binding Status}"/>
                    <TextBlock Text="跟随本机枪口/视线方向投影，不预测散布与弹道下坠。支持第一、第三人称；只在游戏前台显示，不拦截鼠标。若独占全屏不可见，请使用无边框或窗口模式。" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18" Margin="0,0,0,12" Visibility="{Binding IsCombatPage, Converter={StaticResource BoolToVisibility}}">
                  <Grid DataContext="{Binding AimAssist}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="◎" Foreground="#FFFFFFFF" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="原生辅助瞄准" FontSize="16" FontWeight="SemiBold"/>
                          <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="8" Padding="7,2" Margin="9,0,0,0">
                            <TextBlock Text="本机控制" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="SemiBold"/>
                          </Border>
                          <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="7,2" Margin="6,0,0,0">
                            <TextBlock Text="好友房可用" Foreground="{StaticResource AccentDarkBrush}" FontSize="9" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="开镜锁定最近目标 · 同帧跟踪与提前量 · 松镜解除" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <CheckBox Content="启用" IsChecked="{Binding Enabled}" ToolTip="切换后立即应用；修改下方参数后点击应用原生辅助"/>
                        <CheckBox Content="自动提前量" Margin="0,5,0,0" IsChecked="{Binding LeadEnabled}" ToolTip="按当前武器弹速、重力和目标速度计算提前量；瞬时命中武器无需提前量"/>
                        <CheckBox Content="锁定头部" Margin="0,5,0,0" IsChecked="{Binding HeadLockEnabled}" ToolTip="连接后勾选即启用辅助瞄准；按触发方式锁定范围内可见生物的头部判定区，不自动开火"/>
                      </StackPanel>
                    </Grid>
                    <Grid Row="1" Margin="0,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,7,0">
                        <TextBlock Text="辅助强度 0–100" Style="{StaticResource Caption}"/>
                        <app:NumericInputBox Margin="0,5,0,0" Input="{Binding StrengthInput}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="7,0">
                        <TextBlock Text="静默瞄准角度 2–18°" Style="{StaticResource Caption}"/>
                        <app:NumericInputBox Margin="0,5,0,0" Input="{Binding AngleInput}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="7,0">
                        <TextBlock Text="最大距离 10–80m" Style="{StaticResource Caption}"/>
                        <app:NumericInputBox Margin="0,5,0,0" Input="{Binding DistanceInput}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Margin="7,0,0,0">
                        <TextBlock Text="触发方式" Style="{StaticResource Caption}"/>
                        <ComboBox DisplayMemberPath="Label" Margin="0,5,0,0" ItemsSource="{Binding TriggerModes}" SelectedItem="{Binding SelectedTrigger}"/>
                      </StackPanel>
                    </Grid>
                    <Grid Row="2" Margin="0,13,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Text="{Binding Status}"/>
                        <TextBlock Text="开镜后自动转向最大距离内最近的无遮挡目标，不要求目标位于准星附近；目标消失或失效后立即转向下一个，松镜解除。角度仅约束静默瞄准；不自动开火。" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      </StackPanel>
                      <Button Grid.Column="1" Content="应用原生辅助" Style="{StaticResource PrimaryButton}" Padding="20,9" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanConfigure}"/>
                    </Grid>
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding DisplayFeatures}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource FeatureCardStyle}">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                          </Grid.RowDefinitions>
                          <Grid>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Descriptor.Title}"/>
                              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="8,3">
                                  <TextBlock Foreground="{StaticResource AccentDarkBrush}" FontSize="9" FontWeight="SemiBold" Text="{Binding CapabilityLabel}"/>
                                </Border>
                                <TextBlock Text="内存实时" Style="{StaticResource Caption}" Margin="8,3,0,0"/>
                              </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="10" Padding="9,4" VerticalAlignment="Top">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type Border}">
                                  <Setter Property="Background" Value="{StaticResource CardStateIdleBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Value="busy" Binding="{Binding VisualState}">
                                      <Setter Property="Background" Value="{StaticResource CardStateWaitBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Value="waiting" Binding="{Binding VisualState}">
                                      <Setter Property="Background" Value="{StaticResource CardStateWaitBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Value="applied" Binding="{Binding VisualState}">
                                      <Setter Property="Background" Value="{StaticResource CardStateAppliedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Value="failed" Binding="{Binding VisualState}">
                                      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                              <TextBlock FontSize="9" FontWeight="SemiBold" Text="{Binding StateLabel}">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Style.Triggers>
                                      <DataTrigger Value="busy" Binding="{Binding VisualState}">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                      </DataTrigger>
                                      <DataTrigger Value="waiting" Binding="{Binding VisualState}">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                      </DataTrigger>
                                      <DataTrigger Value="applied" Binding="{Binding VisualState}">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                      </DataTrigger>
                                      <DataTrigger Value="failed" Binding="{Binding VisualState}">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </TextBlock>
                            </Border>
                            <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="功能说明" FontSize="10" Margin="0,8,0,0"><TextBlock TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0" Text="{Binding Descriptor.Description}">
                              <FrameworkElement.Style>
                                <Style BasedOn="{StaticResource Muted}" TargetType="{x:Type TextBlock}">
                                  <Style.Triggers>
                                    <DataTrigger Value="" Binding="{Binding Descriptor.Description}">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                            </TextBlock></Expander>
                          </Grid>
                          <ContentControl Grid.Row="1" Content="{Binding}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="ContentTemplate" Value="{StaticResource ActionTemplate}"/>
                                <Style.Triggers>
                                  <DataTrigger Value="{x:Static core:FeatureControl.Toggle}" Binding="{Binding Descriptor.Control}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ToggleTemplate}"/>
                                  </DataTrigger>
                                  <DataTrigger Value="{x:Static core:FeatureControl.Number}" Binding="{Binding Descriptor.Control}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource NumberTemplate}"/>
                                  </DataTrigger>
                                  <DataTrigger Value="{x:Static core:FeatureControl.Generator}" Binding="{Binding Descriptor.Control}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource GeneratorTemplate}"/>
                                  </DataTrigger>
                                  <DataTrigger Value="{x:Static core:FeatureControl.Coordinates}" Binding="{Binding Descriptor.Control}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource CoordinateTemplate}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </ContentControl>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          </Grid>
      </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,0">
        <Grid>
          <!-- 左段用 * 列 + 省略号：原来左段是 HorizontalAlignment 为默认（撑满整行）的
               StackPanel，而 ModeStatus 既没有 TextTrimming 也没有 ToolTip，文案一长就会直接
               压进右段的快捷键提示（右段是同一格里 Right 对齐，两者会重叠）。
               改成「星号列 + Auto 列」后左段最多只能用到右段左边的空间，不会再重叠。 -->
          <!-- 列宽策略：右段（紧急停用快捷键）是**安全关键**信息，交接文档 §7.2/§14 要求
               「紧急停用入口不能过小」、关键提示不能被省略得看不懂，所以它拿 Auto 宽度、
               永不截断；左段（模式状态）放 * 列，空间不足时由它省略，并且有完整 ToolTip。
               背景：上一版是反过来的（左 * 右 Auto 但右段带 TextTrimming），实测右段仍被截掉
               16 DIP —— 安全提示不该是第一个被牺牲的。 -->
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" Text="{Binding ModeStatus}" ToolTip="{Binding ModeStatus}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Margin="16,0,0,0" Text="紧急停用全部持续功能：Ctrl + Shift + F12"
                     Style="{StaticResource Muted}" FontSize="10"
                     TextWrapping="NoWrap" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
  <!-- 失焦时柔化外壳边线：与外层面板同边距/同圆角（直接绑定 ShellSurface），
       只叠一圈 1px 底衬色的不透明度层，不加粗边线、不改布局、不参与命中。 -->
  <Border Style="{StaticResource ShellEdgeScrim}"
          Margin="{Binding Margin, ElementName=ShellSurface}"
          CornerRadius="{Binding CornerRadius, ElementName=ShellSurface}"/>
  </Grid>
</Window>
