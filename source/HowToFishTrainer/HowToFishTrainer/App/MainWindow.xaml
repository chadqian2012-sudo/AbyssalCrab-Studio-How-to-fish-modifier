<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App" xmlns:core="clr-namespace:HowToFishTrainer.Core;assembly=HowToFishTrainer.Core" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="HowToFishTrainer.App.MainWindow" Title="{x:Static app:ProductIdentity.ProductName}" Icon="Assets/Brand/abyssalcrab-app-icon.png" Width="1460" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource BgBrush}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="{StaticResource RadiusWindow}" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <!-- 内容裁剪跟随当前内容层宽高；每次转换产生独享几何，四角均参与裁剪。
           最大化时仍由下面的触发器取消裁剪，恢复窗口后绑定自动接回。 -->
      <app:WindowClipConverter x:Key="WindowClipConverter"/>
      <app:PointDecorationConverter x:Key="PointDecorationConverter"/>
      <!-- 外壳拆成两个兄弟层：装饰层（材质 + 高程落影，无子元素）与内容层（承载全部文字）。
           为什么必须拆：DropShadowEffect 会把整棵子树烘到中间表面，使文字从 ClearType 亚像素抗锯齿
           降级为灰度抗锯齿。外壳是所有文字的祖先，外壳一旦挂 Effect，整个应用都失去文字清晰度。
           把 Effect 只留在无子元素的装饰层上，就没有任何含文字的子树拥有带 Effect 的祖先。 -->
      <!-- 装饰层样式：只承载材质圆角与高程落影，自身无子元素。
           外边距 12 与 theme.xaml 的 GlassShadowWindow 反推一致（BlurRadius 9 的落影在 12 DIP 处
           剩余 alpha 已低于 0.01），所以不会被窗口边缘硬裁出可见硬边。 -->
      <Style x:Key="RoundedWindowSurface" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Effect" Value="{DynamicResource GlassShadowWindow}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}" Value="Maximized">
            <!-- 最大化：外边距归零 + 去掉高程落影，并把圆角一并复位。 -->
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect" Value="{x:Null}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- 内容层样式：无 Effect、无 BorderBrush，透明底，只保留圆角与裁切（圆角外不露方角底色）。
           主容器圆角取 RadiusContainer(20)，比窗口圆角(22)略紧一档。
           WindowState 触发器与装饰层同步复位，最大化时全出血、方角，与改动前一致。 -->
      <Style x:Key="RoundedWindowContent" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="UIElement.Clip">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource WindowClipConverter}" ConverterParameter="{StaticResource RadiusWindowSize}" Mode="OneWay">
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth"/>
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight"/>
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}" Value="Maximized">
            <!-- 最大化：外边距归零 + 圆角归零 + 撤掉裁切。 -->
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="UIElement.Clip" Value="{x:Null}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- 失焦态：工具层（顶栏/导航带）的材质遮罩。只叠一层不透明度层，不写死任何画刷颜色，
           所以不会和材质档切换打架；时长走 MotionStatus，减少动画档下自动归零。 -->
      <Style x:Key="InactiveScrim" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
            <DataTrigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5"
                                   Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}"/>
                </Storyboard>
              </BeginStoryboard>
            </DataTrigger.EnterActions>
            <DataTrigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                   Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}"/>
                </Storyboard>
              </BeginStoryboard>
            </DataTrigger.ExitActions>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- 失焦态：外壳边缘的柔化层。与外层面板同边距、同圆角（直接绑定 ShellSurface），
           只是一圈 1px 底衬色的不透明度层——把边线往背景色上"洗"淡，而不是加粗边线。 -->
      <Style x:Key="ShellEdgeScrim" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource BgBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
            <DataTrigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.55"
                                   Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}"/>
                </Storyboard>
              </BeginStoryboard>
            </DataTrigger.EnterActions>
            <DataTrigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                   Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}"/>
                </Storyboard>
              </BeginStoryboard>
            </DataTrigger.ExitActions>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
      <Style x:Key="ToolbarSoundToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource GlassCardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeChromeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="54"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentLineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="ToggleTemplate">
        <Grid Margin="0,6,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" Text="{Binding Status}" Visibility="{Binding IsStandardToggle, Converter={StaticResource BoolToVisibility}}"/>
          <ToggleButton Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource FeatureSwitch}" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanInteract}"/>
            <Grid Visibility="{Binding IsSpin, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Status}" AutomationProperties.HelpText="{Binding Status}">
              <!-- 转速标签（大陀螺）：「转速（圈/秒，2–15）」在 10px 下需要约 105.3 DIP，原先只有 98 DIP，
                   被 CharacterEllipsis 截掉约 7.3 DIP（独立验收矩阵实测）。这里给它一个 MinWidth 保证
                   不被压，同时补 ToolTip 作为兜底 —— 交接文档 §14 要求「字段错误不能仅省略得看不懂」。 -->
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="108"/><ColumnDefinition Width="76"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="转速（圈/秒，2–15）" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" ToolTip="转速（圈/秒，2–15）"/>
              <TextBox Grid.Column="1" Height="32" Padding="8,4" AutomationProperties.Name="大陀螺转速" ToolTip="每秒 2–15 圈，默认 4；开启时采用输入值，开启后点击应用转速更新" Text="{Binding SpinSpeedText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}"/>
              <Button Grid.Column="2" Height="32" Padding="10,4" Content="应用转速" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding ApplySpinSpeedCommand}" IsEnabled="{Binding CanApplySpinSpeed}"/>
            </Grid>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding HasSpinSpeedError, Converter={StaticResource BoolToVisibility}}" Text="{Binding SpinSpeedValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,3,0,0"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="NumberTemplate">
        <Grid Margin="0,6,0,0">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" Text="{Binding Status}"/>
          <Grid Row="1" Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <app:NumericInputBox Input="{Binding ValueInput}"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Content="应用数值" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanInteract}"/>
          </Grid>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ActionTemplate">
        <Grid Margin="0,6,0,0">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" Text="{Binding Status}"/>
          <Grid Row="1" Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Content="完成后调用游戏原生保存" VerticalAlignment="Center" IsChecked="{Binding SaveAfter}" Visibility="{Binding CanRequestNativeSave, Converter={StaticResource BoolToVisibility}}"/>
            <Button Grid.Column="1" Content="立即执行" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanInteract}"/>
          </Grid>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="CoordinateTemplate">
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <app:NumericInputBox Margin="0,0,5,0" Input="{Binding XInput}"/>
          <app:NumericInputBox Grid.Column="1" Margin="5,0" Input="{Binding YInput}"/>
          <app:NumericInputBox Grid.Column="2" Margin="5,0" Input="{Binding ZInput}"/>
          <Button Grid.Column="3" Margin="7,0,0,0" Content="传送" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanInteract}"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="GeneratorTemplate">
        <Grid Margin="0,6,0,0">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <ComboBox DisplayMemberPath="DisplayName" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"/>
            <app:NumericInputBox Grid.Column="1" Margin="8,0,0,0" Input="{Binding QuantityInput}"/>
          </Grid>
          <Grid Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="10" Style="{StaticResource Muted}" Text="{Binding Status}"/>
              <CheckBox Content="生成后原生保存" Margin="0,4,0,0" IsChecked="{Binding SaveAfter}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="生成到游戏" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanInteract}"/>
          </Grid>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
  <!-- 外层 Grid 只做窗口底衬的承载：Window 的 Background="{StaticResource BgBrush}" 已经铺满整个客户区，
       所以这一层可以完全透明，不需要 Background（窗口外圈 12 DIP 的"底衬环"就是它露出来的部分）。
       两个兄弟层：装饰层（材质 + 高程落影，无子元素）在下，内容层（承载全部文字）在上。 -->
  <Border x:Name="ShellSurface" Style="{StaticResource RoundedWindowSurface}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" Background="{DynamicResource GlassCanvasBrush}" IsHitTestVisible="False"/>
  <!-- 内容层：透明底、无边框、无 Effect；3 行网格（64 / * / 38）整体搬进这里，内部结构未改。 -->
  <Border Style="{StaticResource RoundedWindowContent}" Background="Transparent">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition/>
        <RowDefinition Height="38"/>
      </Grid.RowDefinitions>

      <!-- ===================================================================
           玻璃底层（第 0 层）：独立于所有内容的背景画布。
           整层 IsHitTestVisible=False，只是装饰，不参与命中，不会挡按钮/滚动条/文本选择。
           两枚极低饱和光晕靠右上与左下摆放，避开正文所在的中部区域；正文另有实色料卡
           （GlassCardBrush）压在上面，所以不吃可读性。
           刻意不使用 AllowsTransparency，也不对整窗挂 BlurEffect —— 那会连文字一起糊。
           =================================================================== -->
      <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
        <Ellipse Width="760" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-260,-200,0" Fill="{DynamicResource GlassHaloAccentBrush}" />
        <Ellipse Width="620" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-180,0,0,-240" Fill="{DynamicResource GlassHaloWarmBrush}" />
      </Grid>

      <!-- 顶栏是"浮动工具层"：挂一层极淡的 GlassShadowChrome，让它明显压在导航带/内容之上，而不是与它们齐平。
           但 DropShadowEffect 会把整棵子树烘到中间表面，使文字从 ClearType 亚像素抗锯齿降级为灰度抗锯齿。
           所以把「材质 + 阴影」与「文字内容」拆成兄弟层：装饰层只承载 Background/Effect 且不参与命中，
           内容层保持无 Effect，顶栏与导航带这两条最常读的文字行的清晰度得以保住。 -->
      <Border Background="{DynamicResource GlassChromeBrush}" Effect="{DynamicResource GlassShadowChrome}" IsHitTestVisible="False"/>
      <!-- 顶边镜面高光：贴着外壳顶内沿的 1px 光带（GlassSpecularBrush 是"面"不是描边）。
           压在背景画布与工具层材质之上、顶栏内容之下；不参与命中，也不占布局高度。 -->
      <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
              Background="{DynamicResource GlassSpecularBrush}"/>
      <!-- 失焦遮罩：位于顶栏内容之下，只柔化材质，不压暗任何文字/按钮。 -->
      <Border Style="{StaticResource InactiveScrim}"/>
      <!-- 内容层：透明底 + 底边线。整条顶栏仍可命中（透明背景可命中），
           TitleBar_MouseLeftButtonDown 覆盖整行；装饰层 IsHitTestVisible=False 不会吞点击。 -->
      <Border Background="Transparent" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
              <Image Source="Assets/Brand/abyssalcrab-app-icon.png" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static app:ProductIdentity.ProductName}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="HOW TO FISH TRAINER" Style="{StaticResource Caption}" FontSize="9" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid Column="1" Margin="20,0,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="188"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <!-- 页标题与副标题都允许省略，但必须带 ToolTip：交接文档 §14 要求
                   「顶栏与页脚的详细状态允许省略 + Tooltip」。标题在窄窗口下是会被压的
                   （1180 宽时只有约 278 DIP 可用），没有 ToolTip 就会出现读不全又看不到全文的情况。 -->
              <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PageTitle}"/>
              <TextBlock Text="实时内存控制 · 结果由游戏内运行时确认" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="实时内存控制 · 结果由游戏内运行时确认"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessLineBrush}" BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="10,0,0,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" MaxWidth="150" TextTrimming="CharacterEllipsis" Text="{Binding ConnectionStatus}" ToolTip="{Binding ConnectionStatus}"/>
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding ModeStatus}" ToolTip="{Binding ModeStatus}"/>
          </Grid>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ToggleButton Content="音效" Style="{StaticResource ToolbarSoundToggle}" ToolTip="基础开关成功开启提示音" Margin="0,0,8,0" IsChecked="{Binding SoundEnabled}"/>
            <!-- 材质强度：纯外观设置，三档切换后立即整站生效并持久化到独立的 ui-appearance.json。
                 默认「着色玻璃」（交接文档 §7.3 要求偏可读）；低渲染能力时会被自动压到实色档。
                 必须放在 WindowChrome 的命中区里，否则 WindowStyle=None 下点不到。 -->
            <Menu Background="Transparent" BorderThickness="0" Margin="0,0,6,0" VerticalAlignment="Center">
              <MenuItem x:Name="MaterialMenu" Header="材质" Padding="10,5"
                        ToolTip="玻璃材质强度：实色 / 着色玻璃（默认）/ 通透。纯外观设置，不影响任何功能。">
                <MenuItem x:Name="MaterialSolidItem" Header="实色（可读性最高）" IsCheckable="True" Click="MaterialSolid_Click"/>
                <MenuItem x:Name="MaterialTintedItem" Header="着色玻璃（默认）" IsCheckable="True" Click="MaterialTinted_Click"/>
                <MenuItem x:Name="MaterialClearItem" Header="通透（玻璃感最强）" IsCheckable="True" Click="MaterialClear_Click"/>
              </MenuItem>
            </Menu>
            <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="最小化"/>
            <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="最大化"/>
            <Button x:Name="CloseButton" Content="×" Style="{StaticResource WindowButton}" Foreground="{StaticResource DangerBrush}" Click="Close_Click" ToolTip="关闭"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><!-- 装饰层：材质 + 阴影，不含任何文字（与顶栏同样的拆分理由，避免 DropShadowEffect 把导航项文字降级成灰度抗锯齿）。 --><Border Background="{DynamicResource GlassNavBrush}" Effect="{DynamicResource GlassShadowChrome}" IsHitTestVisible="False"/><!-- 内容层：透明底 + 底边线 + 内边距，承载导航项与胶囊。 --><Border Background="Transparent" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="0,0,0,1" Padding="8,6"><Grid><!-- 失焦遮罩：位于导航项与胶囊之下，只柔化导航带材质。 --><Border Style="{StaticResource InactiveScrim}"/><Canvas x:Name="NavCapsuleLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Canvas.Style><Style TargetType="Canvas"><Style.Triggers><DataTrigger Binding="{Binding CompactNavigation}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
            <!-- 浮动选中胶囊：装饰层，不参与命中。真正选中状态仍来自 ListBox 的 SelectedItem。
                 位移完全由 MainWindow.xaml.cs 的 MoveNavCapsule 计算（同时含 X 与 Y），
                 因为 TopCategories 的 ItemsPanel 是 WrapPanel，窄窗口下会换行，
                 单个横向位移表达不了跨行跳变。 -->
            <Border x:Name="NavCapsule" Background="{DynamicResource GlassNavCapsuleBrush}"
                    BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1"
                    CornerRadius="14" Height="44" VerticalAlignment="Top"
                    RenderTransformOrigin="0,0">
              <!-- 位移用 TranslateTransform、到位收束用 ScaleTransform（缩放中心由代码按实测宽高设定，
                   见 MoveNavCapsule）。两个变换都只作用于 RenderTransform，不动 Width/Height/Margin，
                   所以不会触发长列表重排。 -->
              <Border.RenderTransform>
                <TransformGroup>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                  <TranslateTransform X="0" Y="0" />
                </TransformGroup>
              </Border.RenderTransform>
              <!-- 竖向边缘高光（GlassEdgeVBrush）：让胶囊读成"立起来的玻璃药丸"，而不是一块平色块。 -->
              <Border BorderBrush="{DynamicResource GlassEdgeVBrush}" BorderThickness="1"
                      CornerRadius="13" IsHitTestVisible="False"/>
            </Border>
          </Canvas><ListBox Background="#00FFFFFF" BorderThickness="0" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="TopCategories" MinHeight="48" VerticalAlignment="Top" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="TopCategories_SelectionChanged">
              <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding CompactNavigation}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
              <ItemsControl.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource NavListItem}"><!-- 118px 是实测出来刚好放得下 4 个汉字的宽度，但在 1.5x DPI 的亚像素布局下余量为 0，11 个分类名会被 CharacterEllipsis 各截掉几个 DIP（独立验收矩阵实测最严重差 3.33 DIP）。这里加 6px 宽并以 AccentWashBrush 加粗 1px、外边距由 1 收成 0 把占位补回来，净增 2px 每项，11 项总宽仅 +22px，仍在一行阈值之内。 --><Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,1"/><Setter Property="Width" Value="120"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Glyph}"/>
                    </Border>
                    <!-- 分类名标签：显式 NoWrap + 省略号 + ToolTip。
                         为什么需要这三件事（独立验收矩阵实测）：分类片是固定 120px，一旦分类名超过 4 个字，
                         TextBlock 的 TextWrapping 默认行为会让 TextTrimming 失效 —— 注入 14 字名实测标签变成
                         62×66 DIP（4 行）而分类片只有 120×46 DIP，既没有省略号也没有 ToolTip，文字直接画出片外。
                         当前 11 个名字都是 4 个字所以不触发，但这是固定宽度下的必然隐患，先堵住。 -->
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Left" ToolTip="{Binding Title}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Grid></Border><Grid Margin="24,18,18,16" Grid.Row="1">
          <!-- PageFadeIn 的第二个动画作用在 (UIElement.RenderTransform).(TranslateTransform.Y)，
               所以这里必须显式挂一个 TranslateTransform，否则位移会静默失效（淡入仍生效）。
               注意：不能把它换成 TransformGroup —— 那会让 theme.xaml 里那条 Y 路径失效；
               额外加的"轻微缩放"因此放在下面的内层包装元素 PageScaleHost 上。 -->
          <UIElement.RenderTransform>
            <TranslateTransform Y="0"/>
          </UIElement.RenderTransform>
          <!-- 导航切换时内容区淡入 + 轻微上移：PageTitle 变化即触发 PageFadeIn（定义在 themes/theme.xaml）。
               用 Tag + Binding.TargetUpdated 作为触发器，避免新增 ViewModel 属性。 -->
          <Grid.Triggers>
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
              <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
            </EventTrigger>
          </Grid.Triggers>
          <Grid.Tag>
            <Binding Path="PageTitle" NotifyOnTargetUpdated="True"/>
          </Grid.Tag>
          <!-- 内层包装：承载入场的轻微缩放（0.995→1），给页面切换加一点纵深。
               缩放动画挂在自己的 Grid.Triggers 上、不带 TargetName（和 PageFadeIn 一样直接作用于宿主），
               所以完全不需要动 theme.xaml 里 PageFadeIn 的那条 TranslateTransform.Y 路径。
               行定义跟着搬到这里，子元素照旧用 Row 0/2。 -->
          <Grid x:Name="PageScaleHost" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
