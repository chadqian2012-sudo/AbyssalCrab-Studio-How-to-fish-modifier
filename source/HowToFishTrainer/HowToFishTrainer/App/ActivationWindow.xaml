<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HowToFishTrainer.App.ActivationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:app="clr-namespace:HowToFishTrainer.App;assembly=HowToFishTrainer" Title="赞助版激活" Icon="Assets/Brand/abyssalcrab-app-icon.png" Width="760" Height="680" MinWidth="680" MinHeight="600" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource BgBrush}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- 卡片：白面 + 1px 极浅边线 + 极轻投影（ShadowSoft） -->
    <Style x:Key="CardSurface" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Effect" Value="{StaticResource ShadowSoft}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- 说明卡：只有描边，不加投影（描边优先于阴影） -->
    <Style x:Key="PlainSurface" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- 激活码输入框：圆角 8、焦点 2px AccentBrush 描边（150ms 淡入），无系统虚线焦点框 -->
    <Style x:Key="CodeInput" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionOpacity" Value="0.25" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Grid>
              <Border x:Name="Field" CornerRadius="8" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True" />
              <TextBlock x:Name="Hint" Text="ACST-HTF-PRO-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="12" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
              <!-- TextBox 会把自身 Padding 自动下发给 PART_ContentHost，这里不能再叠一次 Margin -->
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              <Border x:Name="FocusRing" CornerRadius="8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" IsHitTestVisible="False" Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource EaseSoft}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource EaseSoft}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="Field" Property="Border.BorderBrush" Value="{StaticResource AccentSoftBrush}" />
              </Trigger>
              <Trigger Property="TextBox.Text" Value="">
                <Setter TargetName="Hint" Property="UIElement.Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="UIElement.IsEnabled" Value="False">
                <Setter TargetName="Field" Property="Border.Background" Value="{StaticResource BgBrush}" />
                <Setter Property="UIElement.Opacity" Value="0.7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 主按钮：悬停/按下 180ms 颜色过渡（叠加层淡入淡出，不改动画笔资源本身） -->
    <Style x:Key="ActivateActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid>
              <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True" />
              <Border x:Name="HoverLayer" CornerRadius="8" Background="{StaticResource AccentDarkBrush}" Opacity="0" IsHitTestVisible="False" />
              <!-- 按下叠加层为中性黑遮罩（不引入新色相），压在悬停层之上才看得出按下 -->
              <Border x:Name="PressLayer" CornerRadius="8" Background="#000000" Opacity="0" IsHitTestVisible="False" />
              <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="Button.IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="UIElement.IsEnabled" Value="False">
                <Setter Property="UIElement.Opacity" Value="0.45" />
                <Setter TargetName="HoverLayer" Property="UIElement.Opacity" Value="0" />
                <Setter TargetName="PressLayer" Property="UIElement.Opacity" Value="0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 状态徽标字符：内容变化时轻微缩放回弹（纯 XAML 属性 Trigger，未使用任何 Binding） -->
    <Style x:Key="StatusGlyph" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Style.Triggers>
        <Trigger Property="TextBlock.Text" Value="◇">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
        </Trigger>
        <Trigger Property="TextBlock.Text" Value="…">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
        </Trigger>
        <Trigger Property="TextBlock.Text" Value="!">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
        </Trigger>
        <Trigger Property="TextBlock.Text" Value="×">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
        </Trigger>
        <Trigger Property="TextBlock.Text" Value="✓">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.14" Duration="0:0:0.12" AutoReverse="True" EasingFunction="{StaticResource EaseSwitch}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <!-- 窗口内容载入：整体淡入 + 8px 上移（240ms，EaseEnter） -->
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="ShellRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" FillBehavior="Stop" EasingFunction="{StaticResource EaseEnter}" />
          <DoubleAnimation Storyboard.TargetName="ShellRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.24" FillBehavior="Stop" EasingFunction="{StaticResource EaseEnter}" />
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource BgBrush}" CornerRadius="14" ClipToBounds="True" SnapsToDevicePixels="True">
    <Grid x:Name="ShellRoot">
      <Grid.RenderTransform>
        <TranslateTransform Y="0" />
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="70" />
        <RowDefinition />
        <RowDefinition Height="62" />
      </Grid.RowDefinitions>
      <!-- 顶栏：图标 + 标题 + SPONSOR 药丸 + 关闭 -->
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="20,0,9,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/Brand/abyssalcrab-app-icon.png" Width="42" Height="42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="赞助版激活" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Height="18" Padding="8,0" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="SPONSOR" Foreground="{StaticResource AccentDarkBrush}" FontSize="9" FontWeight="SemiBold" TextWrapping="NoWrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
              <TextBlock Text="AbyssalCrab Studio · HOW TO FISH TRAINER" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Content="×" Style="{StaticResource WindowButton}" Click="Close_Click" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel>
          <!-- 状态卡：悬停时投影 ShadowSoft -> CardShadow（150ms） -->
          <Grid>
            <Grid.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="StatusCardHalo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="StatusCardHalo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Grid.Triggers>
            <Border x:Name="StatusCardHalo" Background="{StaticResource CardBrush}" CornerRadius="12" Effect="{StaticResource CardShadow}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="StatusCard" Style="{StaticResource CardSurface}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusAccent" Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                  <TextBlock x:Name="StatusIcon" Text="◇" Style="{StaticResource StatusGlyph}">
                    <TextBlock.RenderTransform>
                      <ScaleTransform ScaleX="1" ScaleY="1" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                  <TextBlock x:Name="StatusTitleText" Text="标准版" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                  <TextBlock x:Name="StatusMessageText" Text="正在读取本机授权状态…" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock Text="设备标识" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                  <TextBlock x:Name="DeviceText" Text="…" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <!-- 激活码卡：输入框与主按钮同一行 -->
          <Border Style="{StaticResource CardSurface}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="输入激活码" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="激活码只发送给AbyssalCrab Studio，不会注入游戏进程。" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ActivationCodeBox" Style="{StaticResource CodeInput}" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Center" ToolTip="ACST-HTF-PRO-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" />
                <Button x:Name="ActivateButton" Grid.Column="1" Content="激活赞助版" Style="{StaticResource ActivateActionButton}" Margin="8,0,0,0" MinWidth="132" Click="Activate_Click" RenderTransformOrigin="0.5,0.5">
                  <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                  </Button.RenderTransform>
                  <Button.Triggers>
                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ActivateButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                          <DoubleAnimation Storyboard.TargetName="ActivateButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ActivateButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                          <DoubleAnimation Storyboard.TargetName="ActivateButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ActivateButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                          <DoubleAnimation Storyboard.TargetName="ActivateButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Button.Triggers>
                </Button>
              </Grid>
              <TextBlock x:Name="ActionMessageText" Text="标准版功能无需激活即可使用。" Style="{StaticResource Muted}" FontSize="10" Margin="2,12,0,0" />
            </StackPanel>
          </Border>
          <!-- 版本对比：左标准版白卡，右赞助版浅紫底卡（文案与原文件逐字一致） -->
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PlainSurface}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="标准版" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="✓ 常用修改、武器战斗、钓鱼辅助、金钱背包&#xA;✓ 世界传送与解锁中心&#xA;✓ 浏览全部目录并管理本地传送点&#xA;✓ 物品、鱼类生成与趣味小功能需赞助版" Style="{StaticResource Muted}" FontSize="11" LineHeight="21" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AccentTintBrush}" BorderBrush="{StaticResource AccentEdgeBrush}" BorderThickness="1" CornerRadius="12" Padding="16" SnapsToDevicePixels="True" Margin="8,0,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="赞助版" Foreground="{StaticResource AccentDarkBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Width="18" Height="2" CornerRadius="1" Background="{StaticResource GoldBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="包含全部标准版功能，并解锁三个高级页面：&#xA;◆ 物品与武器生成、鱼类生成&#xA;◆ 趣味小功能（执行与清理）" Foreground="{StaticResource AccentDarkBrush}" FontSize="11" LineHeight="21" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          </Grid>
          <ContentControl x:Name="PurchaseHost" Visibility="Collapsed" Margin="0,16,0,0" />
        </StackPanel>
      </ScrollViewer>
      <!-- 底栏：危险操作在左，主操作在右，间距 8 -->
      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ClearButton" Content="清除本机授权" Style="{StaticResource DangerButton}" Click="Clear_Click" />
            <Button x:Name="RefreshButton" Content="重新校验" Margin="8,0,0,0" Click="Refresh_Click" />
          </StackPanel>
          <Button Grid.Column="1" Content="完成" Style="{StaticResource PrimaryButton}" MinWidth="100" VerticalAlignment="Center" Click="Close_Click" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
