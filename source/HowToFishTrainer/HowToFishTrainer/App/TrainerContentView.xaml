                      <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Text="{Binding Status}"/>
                        <TextBlock Text="开镜后优先锁定最大距离内无遮挡的 Boss，其次可攻击动物，最后玩家；同类优先最近目标。目标消失或失效后切换，松镜解除，不自动开火。魔法子弹使用独立的捕获角度、距离与强度设置。" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      </StackPanel>
                      <Button Grid.Column="1" Content="应用原生辅助" Style="{StaticResource PrimaryButton}" Padding="20,9" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanConfigure}"/>
                    </Grid>
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding DisplayFeatures}" ItemTemplate="{StaticResource FeatureCardTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid>
                        <UniformGrid.Style><Style TargetType="UniformGrid">
                          <Setter Property="Columns" Value="2"/>
                          <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type app:TrainerContentView}}}" Value="True"/>
                            <Condition Binding="{Binding IsCombatPage}" Value="False"/>
                            <Condition Binding="{Binding IsTeleportPage}" Value="False"/>
                          </MultiDataTrigger.Conditions><Setter Property="Columns" Value="1"/></MultiDataTrigger></Style.Triggers>
                        </Style></UniformGrid.Style>
                      </UniformGrid>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>

                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          </ScrollViewer>
          </Grid>
      </Grid>
      </Grid>
</UserControl>
