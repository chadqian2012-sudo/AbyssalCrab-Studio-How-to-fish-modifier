<UserControl x:Class="HowToFishTrainer.App.TrainerContentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App" xmlns:core="clr-namespace:HowToFishTrainer.Core;assembly=HowToFishTrainer.Core">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/HowToFishTrainer;component/HowToFishTrainer/App/FeatureTemplates.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><!-- 装饰层：材质 + 阴影，不含任何文字（与顶栏同样的拆分理由，避免 DropShadowEffect 把导航项文字降级成灰度抗锯齿）。 --><Border Background="{DynamicResource GlassNavBrush}" Effect="{DynamicResource GlassShadowChrome}" IsHitTestVisible="False"/><!-- 内容层：透明底 + 底边线 + 内边距，承载导航项与胶囊。 --><Border Background="Transparent" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="0,0,0,1" Padding="8,6"><Grid><!-- 失焦遮罩：位于导航项与胶囊之下，只柔化导航带材质。 --><Border Style="{StaticResource InactiveScrim}"/><Canvas x:Name="NavCapsuleLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Canvas.Style><Style TargetType="Canvas"><Style.Triggers><DataTrigger Binding="{Binding CompactNavigation}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
            <!-- 选中胶囊由 TrainerContentView 按分类的实际位置定位。
                 选择时平滑移动，导航滚动时立即跟随；不参与命中。 -->
            <Border x:Name="NavCapsule" Background="{DynamicResource GlassNavCapsuleBrush}"
                    BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1"
                    CornerRadius="14" Height="44" VerticalAlignment="Top"
                    RenderTransformOrigin="0,0">
              <!-- 位移用 TranslateTransform、到位收束用 ScaleTransform（缩放中心由代码按实测宽高设定，
                   见 MoveNavCapsule）。两个变换都只作用于 RenderTransform，不动 Width/Height/Margin，
                   所以不会触发长列表重排。 -->
              <Border.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="NavScale" />
                  <TranslateTransform x:Name="NavOffset" />
                </TransformGroup>
              </Border.RenderTransform>
              <!-- 竖向边缘高光（GlassEdgeVBrush）：让胶囊读成"立起来的玻璃药丸"，而不是一块平色块。 -->
              <Border BorderBrush="{DynamicResource GlassEdgeVBrush}" BorderThickness="1"
                      CornerRadius="13" IsHitTestVisible="False"/>
            </Border>
          </Canvas><ListBox Background="#00FFFFFF" BorderThickness="0" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" x:Name="TopCategories" MinHeight="48" VerticalAlignment="Top" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="TopCategories_SelectionChanged" ScrollViewer.ScrollChanged="TopCategories_ScrollChanged">
              <ListBox.Style><Style TargetType="ListBox">
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type app:TrainerContentView}}}" Value="True">
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CompactNavigation}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style></ListBox.Style>
              <ItemsControl.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource NavListItem}"><!-- 118px 是实测出来刚好放得下 4 个汉字的宽度，但在 1.5x DPI 的亚像素布局下余量为 0，11 个分类名会被 CharacterEllipsis 各截掉几个 DIP（独立验收矩阵实测最严重差 3.33 DIP）。这里加 6px 宽并以 AccentWashBrush 加粗 1px、外边距由 1 收成 0 把占位补回来，净增 2px 每项，11 项总宽仅 +22px，仍在一行阈值之内。 --><Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,1"/><Setter Property="Width" Value="120"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Glyph}"/>
                    </Border>
                    <!-- 分类名标签：显式 NoWrap + 省略号 + ToolTip。
                         为什么需要这三件事（独立验收矩阵实测）：分类片是固定 120px，一旦分类名超过 4 个字，
                         TextBlock 的 TextWrapping 默认行为会让 TextTrimming 失效 —— 注入 14 字名实测标签变成
                         62×66 DIP（4 行）而分类片只有 120×46 DIP，既没有省略号也没有 ToolTip，文字直接画出片外。
                         当前 11 个名字都是 4 个字所以不触发，但这是固定宽度下的必然隐患，先堵住。 -->
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Left" ToolTip="{Binding Title}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Grid></Border><Grid Grid.Row="1">
          <Grid.Style><Style TargetType="Grid">
            <Setter Property="Margin" Value="24,18,18,16"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type app:TrainerContentView}}}" Value="True"><Setter Property="Margin" Value="12,12,6,10"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
          <!-- PageFadeIn 的第二个动画作用在 (UIElement.RenderTransform).(TranslateTransform.Y)，
               所以这里必须显式挂一个 TranslateTransform，否则位移会静默失效（淡入仍生效）。
               注意：不能把它换成 TransformGroup —— 那会让 theme.xaml 里那条 Y 路径失效；
               额外加的"轻微缩放"因此放在下面的内层包装元素 PageScaleHost 上。 -->
          <UIElement.RenderTransform>
            <TranslateTransform Y="0"/>
          </UIElement.RenderTransform>
          <!-- 导航切换时内容区淡入 + 轻微上移：PageTitle 变化即触发 PageFadeIn（定义在 themes/theme.xaml）。
               用 Tag + Binding.TargetUpdated 作为触发器，避免新增 ViewModel 属性。 -->
          <Grid.Triggers>
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
              <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
            </EventTrigger>
          </Grid.Triggers>
          <Grid.Tag>
            <Binding Path="PageTitle" NotifyOnTargetUpdated="True"/>
          </Grid.Tag>
          <!-- 内层包装：承载入场的轻微缩放（0.995→1），给页面切换加一点纵深。
               缩放动画挂在自己的 Grid.Triggers 上、不带 TargetName（和 PageFadeIn 一样直接作用于宿主），
               所以完全不需要动 theme.xaml 里 PageFadeIn 的那条 TranslateTransform.Y 路径。
               行定义跟着搬到这里，子元素照旧用 Row 0/2。 -->
          <Grid x:Name="PageScaleHost" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Grid.Triggers>
              <EventTrigger RoutedEvent="Binding.TargetUpdated">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.995" To="1" FillBehavior="Stop"
                                     Duration="{StaticResource MotionPage}" EasingFunction="{StaticResource EaseEnter}"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.995" To="1" FillBehavior="Stop"
                                     Duration="{StaticResource MotionPage}" EasingFunction="{StaticResource EaseEnter}"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Grid.Triggers>
            <Grid.Tag>
              <Binding Path="PageTitle" NotifyOnTargetUpdated="True"/>
            </Grid.Tag>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 顶栏已经显示当前分类，页头不再重复一行说明文字；把原有的运行时说明收到标题右侧，
                 让卡片区多出约 22px 高度，同时保留这条语义信息。 -->
            <TextBlock Style="{StaticResource H1}" Text="{Binding PageTitle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="即时写入内存 · 持续功能关闭时恢复原始状态" Style="{StaticResource Muted}"
                       FontSize="10" VerticalAlignment="Bottom" Margin="12,0,0,4"
                       TextTrimming="CharacterEllipsis" ToolTip="即时写入内存 · 持续功能关闭时恢复原始状态"/>
          </Grid>
          <app:ExperienceBar Grid.Row="1"/>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" IsEnabled="{Binding CanEditParameters}">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers>
              <DataTrigger Binding="{Binding IsCatalogPage}" Value="True"><Setter Property="MinWidth" Value="1040"/><Setter Property="MinHeight" Value="520"/></DataTrigger>
              <DataTrigger Binding="{Binding IsRoomMembersPage}" Value="True"><Setter Property="MinWidth" Value="1040"/><Setter Property="MinHeight" Value="520"/></DataTrigger>
              <DataTrigger Binding="{Binding IsFunEventsPage}" Value="True"><Setter Property="MinWidth" Value="1040"/><Setter Property="MinHeight" Value="520"/></DataTrigger>
              <DataTrigger Binding="{Binding IsEntertainmentPage}" Value="True"><Setter Property="MinWidth" Value="1040"/><Setter Property="MinHeight" Value="520"/></DataTrigger>
              <DataTrigger Binding="{Binding IsCombatPage}" Value="True"><Setter Property="MinWidth" Value="1040"/><Setter Property="MinHeight" Value="520"/></DataTrigger>
              <DataTrigger Binding="{Binding IsTeleportPage}" Value="True"><Setter Property="MinWidth" Value="1040"/><Setter Property="MinHeight" Value="520"/></DataTrigger>
            </Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="14" Margin="0,0,8,12" Visibility="{Binding IsCatalogPage, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11" Text="{Binding CatalogStatus}"/>
                <Button Grid.Column="1" Content="重新读取游戏目录" Command="{Binding RefreshCatalogCommand}"/>
              </Grid>
            </Border>
            <Border Name="GeneratorWorkspace" Grid.Row="1" Margin="0,0,8,0" Visibility="{Binding IsCatalogPage, Converter={StaticResource BoolToVisibility}}">
              <Grid DataContext="{Binding ActiveGenerator}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210"/>
                  <ColumnDefinition Width="1.15*"/>
                  <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18" Margin="0,0,10,0">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="分类浏览" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="目录已按游戏实时类型整理" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,15"/>
                    <ListBox Grid.Row="2" Style="{StaticResource OptionListBox}" Margin="0,0,0,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,7">
                            <TextBlock Foreground="{StaticResource AccentDarkBrush}" FontWeight="SemiBold" Text="{Binding}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="物品页已排除全部鱼类；鱼类页只显示可生成鱼种。" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="10" Margin="2,10,2,0"/>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18" Margin="0,0,10,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                      <TextBlock Text="实时游戏目录" FontSize="17" FontWeight="SemiBold"/>
                      <ComboBox Margin="0,8,0,7" ItemsSource="{Binding CatalogViews}" SelectedItem="{Binding CatalogView}" ToolTip="全部目录、收藏与最近生成"/>
                      <TextBox ToolTip="搜索名称或ID" Margin="0,0,0,7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                      <DockPanel Margin="0,0,0,7"><Button DockPanel.Dock="Right" Content="记住搜索" Padding="8,4" Command="{Binding RememberSearchCommand}"/><ComboBox ItemsSource="{Binding RecentSearches}" SelectedItem="{Binding SelectedRecentSearch}" ToolTip="最近搜索" Margin="0,0,7,0"/></DockPanel>
                    </StackPanel>
                    <ListBox Grid.Row="1" Style="{StaticResource OptionListBox}" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding FilteredOptions}" SelectedItem="{Binding SelectedOption}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="11">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" Text="{Binding Kind}"/>
                              </StackPanel>
                              <TextBlock Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding Id, StringFormat=ID {0}}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="生成详情" FontSize="17" FontWeight="SemiBold"/>
                      <TextBlock FontSize="20" FontWeight="Bold" Margin="0,12,0,2" Text="{Binding SelectedOption.Name, FallbackValue=请先选择物品}"/>
                      <TextBlock Style="{StaticResource Muted}" FontSize="10" Text="{Binding SelectedOption.DisplayName}"/>
                      <Button Content="{Binding FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}" Margin="0,9,0,0"/>
                      <Button Content="恢复收藏 / 最近生成配置" Command="{Binding RestoreBookmarkedConfigurationCommand}" Margin="0,7,0,0"/>
                      <StackPanel Visibility="{Binding ShowWeaponConfiguration, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl Margin="0,14,0,4" ItemsSource="{Binding SelectedOption.Performance}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="88"/>
                                  <ColumnDefinition/>
                                  <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="10" Text="{Binding Name}"/>
                                <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="1" Foreground="{StaticResource AccentBrush}" Background="{StaticResource ProgressTrackBrush}" Value="{Binding Ratio}"/>
                                <TextBlock Grid.Column="2" FontSize="10" HorizontalAlignment="Right" Text="{Binding RawValue}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="武器配件" FontWeight="SemiBold" Margin="0,12,0,7"/>
                        <TextBlock Text="只列出该武器预制体实际支持的配件" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,0,8"/>
                        <ComboBox DisplayMemberPath="Name" ToolTip="瞄具（仅显示兼容项）" Margin="0,0,0,7" ItemsSource="{Binding SelectedOption.Sights}" SelectedItem="{Binding SelectedSight}"/>
                        <ComboBox DisplayMemberPath="Name" ToolTip="枪管（仅显示兼容项）" Margin="0,0,0,7" ItemsSource="{Binding SelectedOption.Barrels}" SelectedItem="{Binding SelectedBarrel}"/>
                        <ComboBox DisplayMemberPath="Name" ToolTip="弹药升级（仅显示兼容项）" ItemsSource="{Binding SelectedOption.Ammo}" SelectedItem="{Binding SelectedAmmo}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                          <CheckBox Content="扩容弹匣" Margin="0,0,18,0" IsChecked="{Binding ExtendedMagazine}" IsEnabled="{Binding SelectedOption.SupportsExtendedMagazine}"/>
                          <CheckBox Content="激光瞄准器" IsChecked="{Binding LaserSight}" IsEnabled="{Binding SelectedOption.SupportsLaserSight}"/>
                        </StackPanel>
                      </StackPanel>
                      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0" Visibility="{Binding ShowSkinConfiguration, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                          <TextBlock Text="原生皮肤" FontWeight="SemiBold" Margin="0,0,0,7"/>
                          <ComboBox DisplayMemberPath="DisplayName" ToolTip="留空使用物品默认皮肤" ItemsSource="{Binding SelectedOption.Skins}" SelectedItem="{Binding SelectedSkin}"/>
                        </StackPanel>
                      </Border>
                      <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition/>
                          <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0">
                          <TextBlock Text="数量" Style="{StaticResource Caption}"/>
                          <app:NumericInputBox Margin="0,5,0,0" Input="{Binding QuantityInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                          <TextBlock Text="眼前距离（米）" Style="{StaticResource Caption}"/>
                          <app:NumericInputBox Margin="0,5,0,0" Input="{Binding DistanceInput}"/>
                        </StackPanel>
                      </Grid>
                      <Grid Margin="0,10,0,0" Visibility="{Binding ShowFishConfiguration, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="鱼类状态" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <RadioButton Content="活鱼" Margin="0,0,12,0" IsChecked="{Binding AliveFish}"/>
                          <RadioButton Content="死鱼" IsChecked="{Binding DeadFish}"/>
                        </StackPanel>
                        <Grid Row="1" Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                          </Grid.ColumnDefinitions>
                          <CheckBox Content="生成极品鱼" IsChecked="{Binding Rare}"/>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="重量倍率" Style="{StaticResource Caption}"/>
                            <app:NumericInputBox Margin="0,4,0,0" Input="{Binding WeightInput}"/>
                          </StackPanel>
                        </Grid>
                      </Grid>
                      <CheckBox Content="生成后调用游戏原生保存" IsChecked="{Binding SaveAfter}" Margin="0,12,0,0"/>
                      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,12,0,8" Text="{Binding Status}"/>
                      <Button Style="{StaticResource PrimaryButton}" Height="42" Content="{Binding ExecuteButtonText}" Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanGenerate}"/>
                      <Button Content="清理本次生成" Style="{StaticResource DangerButton}" Height="38" Margin="0,8,0,0" Command="{Binding CleanupCommand}" IsEnabled="{Binding CanInteract}"/>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Border>
            <Grid Row="1" Margin="0,0,8,0" Visibility="{Binding IsRoomMembersPage, Converter={StaticResource BoolToVisibility}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="350"/>
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{StaticResource AccentBrush}" CornerRadius="10">
                      <TextBlock Text="♙" Foreground="#FFFFFFFF" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0">
                      <TextBlock Text="房间成员控制台" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="所有结果以游戏运行时读回为准" Style="{StaticResource Muted}" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="18,0">
                    <TextBlock Text="在线" Style="{StaticResource Caption}"/>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" Text="{Binding RoomMembersPage.OnlineCount}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="18,0">
                    <TextBlock Text="存活" Style="{StaticResource Caption}"/>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Text="{Binding RoomMembersPage.AliveCount}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Margin="18,0">
                    <TextBlock Text="倒地" Style="{StaticResource Caption}"/>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Text="{Binding RoomMembersPage.DownCount}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="16" Margin="0,0,10,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="在线成员" FontSize="17" FontWeight="SemiBold"/>
                      <TextBlock Text="从当前 Owner 会话实时读取" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="↻  刷新" Padding="11,5" Command="{Binding RoomMembersPage.RefreshCommand}" IsEnabled="{Binding RoomMembersPage.CanManage}"/>
                  </Grid>
                  <TextBox Grid.Row="1" Margin="0,12,0,8" ToolTip="搜索玩家名称、会话尾号或角色" Text="{Binding RoomMembersPage.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                  <ListBox Grid.Row="2" Style="{StaticResource OptionListBox}" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding RoomMembersPage.FilteredMembers}" SelectedItem="{Binding RoomMembersPage.SelectedMember}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="9">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="34"/>
                              <ColumnDefinition/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                              <TextBlock Text="♙" Foreground="{StaticResource AccentDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0">
                              <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
