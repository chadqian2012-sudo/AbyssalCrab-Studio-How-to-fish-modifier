<UserControl x:Class="HowToFishTrainer.App.FeelPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App">
  <UserControl.Resources>
    <Style x:Key="FeelTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="5" VerticalAlignment="Center" CornerRadius="2.5" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="FeelThumb" TargetType="Thumb">
      <Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Grid x:Name="ThumbRoot" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform><Ellipse Fill="{DynamicResource FieldBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="{StaticResource MotionHover}"/>
            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="{StaticResource MotionHover}"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource MotionHover}"/>
            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource MotionHover}"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FeelSlider" TargetType="Slider"><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="28" Background="Transparent"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource FeelTrackButton}" Background="{StaticResource AccentBrush}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource FeelThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource FeelTrackButton}" Background="{StaticResource LineBrush}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </UserControl.Resources>
  <Border Style="{StaticResource FeatureCardStyle}" MinHeight="0" Padding="18" Margin="0,0,8,12">
    <StackPanel>
      <TextBlock Text="角色手感与常用参数" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="拖动滑块或输入小数，点击应用后生效。重置只恢复输入默认值。" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,10"/>
      <ItemsControl ItemsSource="{Binding FeelFeatures}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="11" Margin="0,0,10,6">
              <StackPanel>
                <DockPanel><TextBlock Text="{Binding Descriptor.Title}" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="重置" Command="{Binding ResetParametersCommand}" Padding="10,3"/></DockPanel>
                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Slider Style="{StaticResource FeelSlider}" Minimum="{Binding ValueInput.Minimum}" Maximum="{Binding ValueInput.Maximum}" Value="{Binding ValueInput.Value,Mode=OneWay}" ValueChanged="FeelSlider_ValueChanged" VerticalAlignment="Top" Margin="0,3,9,0" ToolTip="{Binding ValueInput.RangeDescription}"/>
                  <app:NumericInputBox Grid.Column="1" Input="{Binding ValueInput}"><app:NumericInputBox.Resources><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="12"/></Style></app:NumericInputBox.Resources></app:NumericInputBox>
                  <Button Grid.Column="2" Content="应用" Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanInteract}" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" VerticalAlignment="Top" Padding="10,6"/>
                </Grid>
                <TextBlock Text="{Binding ValueInput.RangeDescription}" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
