<Window x:Class="HowToFishTrainer.App.StatusWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App" Title="AbyssalCrab Studio · 游戏面板" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/HowToFishTrainer;component/HowToFishTrainer/App/FeatureTemplates.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="0,0,5,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
      <DataTemplate x:Key="OverlayShortcutTemplate">
        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,8,10">
          <StackPanel>
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="参数" Command="{Binding OpenCommand}" Margin="4,0" ToolTip="在全部功能中编辑"/><Button Content="↑" Command="{Binding MoveUpCommand}" Padding="8,3" ToolTip="上移"/><Button Content="↓" Command="{Binding MoveDownCommand}" Padding="8,3" ToolTip="下移" Margin="4,0"/><Button Content="×" Command="{Binding RemoveCommand}" Padding="8,3" ToolTip="从面板移除"/></StackPanel>
              <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding KindLabel}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel>
            </DockPanel>
            <ContentControl Content="{Binding Feature}" Margin="0,6,0,0"><ContentControl.Style><Style TargetType="ContentControl" BasedOn="{StaticResource FeatureEditorStyle}"><Style.Triggers><DataTrigger Binding="{Binding Feature}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
            <Button Content="快捷调用" Command="{Binding ExecuteCommand}" IsEnabled="{Binding IsAvailable}" HorizontalAlignment="Left" Margin="0,10,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Feature}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Border x:Name="Launcher" CornerRadius="18" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1" Padding="6" Cursor="Hand" ToolTip="点击打开游戏面板；拖动调整位置" MouseLeftButtonDown="Drag_MouseDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseUp">
      <TextBlock Text="AC" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Border x:Name="ExpandedSurface" Visibility="Collapsed" CornerRadius="18" Background="{DynamicResource GlassCanvasBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" Padding="12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Drag_MouseDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseUp"><StackPanel><TextBlock Text="AbyssalCrab Studio" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="紧急停用" Command="{Binding EmergencyDisableCommand}" Foreground="{DynamicResource DangerBrush}" Margin="8,0"/><Button Content="收起" Click="Collapse_Click" ToolTip="收起并返回游戏"/></StackPanel>
        </Grid>
        <TabControl x:Name="OverlayTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,8,0,0">
          <TabItem Header="快捷面板"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="0,4,0,10"><Button Content="编辑面板" Click="Settings_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/><ComboBox ItemsSource="{Binding OverlayPanels}" SelectedItem="{Binding SelectedOverlayPanel}" DisplayMemberPath="Name" ToolTip="切换自定义快捷面板"/></DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="面板还没有快捷项。到设置、传送点或参数预设中添加。" Margin="6,16" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedOverlayPanel.Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SelectedOverlayPanel}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl ItemsSource="{Binding SelectedOverlayPanel.Items}" ItemTemplate="{StaticResource OverlayShortcutTemplate}"/></StackPanel></ScrollViewer>
          </Grid></TabItem>
          <TabItem Header="全部功能"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><app:TrainerContentView x:Name="TrainerContent" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="1040"/></ScrollViewer></TabItem>
          <TabItem Header="传送点"><Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,3,0,10"><Button Content="读取本机位置" Command="{Binding ReadLocalPositionCommand}" Margin="0,0,8,0"/><Button Content="管理坐标" Click="TeleportPage_Click"/><TextBlock Text="快捷传送作用于本机玩家" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/></WrapPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding TeleportPoints}" SelectedItem="{Binding SelectedTeleportPoint}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border CornerRadius="12" Padding="12" Margin="0,0,0,6" Background="{DynamicResource GlassCardBrush}"><DockPanel><Button Content="传送" DockPanel.Dock="Right" Command="{Binding DataContext.TeleportSavedPointCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Group}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><Button Content="将选中传送点加入当前面板" Command="{Binding AddTeleportToOverlayCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding PositionStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="参数预设"><Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" ToolTip="预设名称"/><Button Grid.Column="1" Content="保存当前参数" Command="{Binding SavePresetCommand}" Margin="8,0,0,0"/></Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border CornerRadius="12" Padding="12" Margin="0,0,0,6" Background="{DynamicResource GlassCardBrush}"><DockPanel><Button Content="恢复参数" DockPanel.Dock="Right" Command="{Binding DataContext.LoadOverlayPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><WrapPanel><Button Content="将选中预设加入当前面板" Command="{Binding AddPresetToOverlayCommand}" Margin="0,0,8,0"/><Button Content="重命名预设" Command="{Binding RenamePresetCommand}" Margin="0,0,8,0"/><Button Content="删除预设" Command="{Binding DeletePresetCommand}"/></WrapPanel><TextBlock Text="恢复预设会停用持续功能并载入参数；需要的功能请手动开启。" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock Text="{Binding ExperienceStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
            <CheckBox Content="启用游戏悬浮窗" IsChecked="{Binding WidgetVisible}" Margin="0,0,0,16"/><TextBlock Text="我的快捷面板" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding OverlayPanels}" SelectedItem="{Binding SelectedOverlayPanel}" DisplayMemberPath="Name" Margin="0,10,0,8"/>
            <TextBox Text="{Binding OverlayPanelName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" ToolTip="面板名称"/>
            <WrapPanel Margin="0,9,0,18"><Button Content="新建面板" Command="{Binding CreateOverlayPanelCommand}" Margin="0,0,8,0"/><Button Content="重命名" Command="{Binding RenameOverlayPanelCommand}" Margin="0,0,8,0"/><Button Content="删除面板" Command="{Binding DeleteOverlayPanelCommand}"/></WrapPanel>
            <TextBlock Text="添加功能" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding OverlayFeatureChoices}" SelectedItem="{Binding SelectedOverlayFeatureChoice}" DisplayMemberPath="Title" IsTextSearchEnabled="True" Margin="0,10,0,8"/><Button Content="加入当前面板" Command="{Binding AddFeatureToOverlayCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="传送点与参数预设可以在各自页签加入当前面板。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>
            <TextBlock Text="展开 / 收起快捷键" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding OverlayHotkey, UpdateSourceTrigger=LostFocus}" Margin="0,10,0,8" ToolTip="例如 Home、F8 或 Ctrl+Home；修改后离开输入框生效"/>
            <TextBlock Text="支持窗口化和无边框全屏。展开时键鼠操作面板，收起后返回游戏。Esc 可收起；Ctrl + Shift + F12 始终用于紧急停用。" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11"/>
          </StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="{Binding OverlayStatus}" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/><Thumb Grid.Column="1" Cursor="SizeNWSE" DragDelta="Resize_DragDelta" Width="18" Height="18" VerticalAlignment="Bottom"><Thumb.Template><ControlTemplate TargetType="Thumb"><TextBlock Text="◢" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></ControlTemplate></Thumb.Template></Thumb></Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
