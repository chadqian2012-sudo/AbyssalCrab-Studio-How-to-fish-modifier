<Window x:Class="HowToFishTrainer.App.StatusWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App" Title="AbyssalCrab Studio · 游戏面板" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/HowToFishTrainer;component/HowToFishTrainer/App/FeatureTemplates.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="8,9"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Margin="2">
            <ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource MutedBrush}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource AccentDarkBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource GlassNavCapsuleBrush}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource GlassEdgeChromeBrush}"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource AccentDarkBrush}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <DataTemplate x:Key="OverlayShortcutTemplate">
        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,6,8">
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Title}"/>
            <Grid Margin="0,3,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="参数" Command="{Binding OpenCommand}" Style="{StaticResource GhostButton}" Height="28" Padding="9,3" Margin="0,0,4,0" ToolTip="在全部功能中编辑"/>
                <Button Content="↑" Command="{Binding MoveUpCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="上移" AutomationProperties.Name="上移快捷项"/>
                <Button Content="↓" Command="{Binding MoveDownCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="2,0" ToolTip="下移" AutomationProperties.Name="下移快捷项"/>
                <Button Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource IconButton}" Foreground="{DynamicResource MutedBrush}" Width="28" Height="28" ToolTip="从面板移除" AutomationProperties.Name="从面板移除快捷项"/>
              </StackPanel>
            </Grid>
            <ContentControl Content="{Binding Feature}" Margin="0,2,0,0"><ContentControl.Style><Style TargetType="ContentControl" BasedOn="{StaticResource FeatureEditorStyle}"><Style.Triggers><DataTrigger Binding="{Binding Feature}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
            <Button Content="快捷调用" Command="{Binding ExecuteCommand}" IsEnabled="{Binding IsAvailable}" HorizontalAlignment="Left" Padding="12,6" Margin="0,6,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Feature}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Border x:Name="Launcher" CornerRadius="18" Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1" Padding="6" Cursor="Hand" ToolTip="点击打开游戏面板；拖动调整位置" MouseLeftButtonDown="Drag_MouseDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseUp">
      <Grid>
        <Border Height="1" Margin="4,0,4,0" VerticalAlignment="Top" Background="{DynamicResource GlassSpecularBrush}" IsHitTestVisible="False"/>
        <TextBlock Text="AC" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/>
        <Border Width="12" Height="2" CornerRadius="1" Background="{DynamicResource AccentLineBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" IsHitTestVisible="False"/>
      </Grid>
    </Border>
    <Border x:Name="ExpandedSurface" Visibility="Collapsed" CornerRadius="18" Background="{DynamicResource GlassCanvasBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" Padding="12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Drag_MouseDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseUp" ToolTip="拖动调整游戏面板位置">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="AC" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="AbyssalCrab Studio" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="AbyssalCrab Studio"/><TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource Muted}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionStatus}" Margin="0,2,0,0"/></StackPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Content="紧急停用" Command="{Binding EmergencyDisableCommand}" Foreground="{DynamicResource DangerBrush}" Background="{DynamicResource GlassCardBrush}" Padding="10,7" ToolTip="立即停用持续功能 · Ctrl + Shift + F12"/>
            <Button Content="收起" Click="Collapse_Click" Style="{StaticResource GhostButton}" Padding="10,7" Margin="4,0,0,0" ToolTip="收起并返回游戏 · Esc"/>
          </StackPanel>
        </Grid>
        <TabControl x:Name="OverlayTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
          <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Border Background="{DynamicResource GlassNavBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="13" Padding="2"><UniformGrid Rows="1" Columns="5" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/></Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="{TemplateBinding Padding}" ContentSource="SelectedContent"/>
          </Grid></ControlTemplate></TabControl.Template>
          <TabItem Header="快捷面板"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8"><Button Content="编辑面板" Click="Settings_Click" DockPanel.Dock="Right" Padding="12,7" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding OverlayPanels}" SelectedItem="{Binding SelectedOverlayPanel}" DisplayMemberPath="Name" Height="34" ToolTip="切换自定义快捷面板" AutomationProperties.Name="当前快捷面板"/></DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,2"><StackPanel>
              <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,6,8">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedOverlayPanel.Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SelectedOverlayPanel}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" MaxWidth="360">
                  <Border Width="40" Height="40" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"><TextBlock Text="+" FontSize="24" Foreground="{DynamicResource AccentDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <TextBlock Text="把常用操作放在这里" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                  <TextBlock Text="添加功能、传送点或参数预设，游戏中就能直接调用。" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>
                  <Button Content="添加快捷项" Click="Settings_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="16,8"/>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding SelectedOverlayPanel.Items}" ItemTemplate="{StaticResource OverlayShortcutTemplate}"/>
            </StackPanel></ScrollViewer>
          </Grid></TabItem>
          <TabItem Header="全部功能"><app:TrainerContentView x:Name="TrainerContent"/></TabItem>
          <TabItem Header="传送点"><Grid Margin="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,10"><Button Content="读取本机位置" Command="{Binding ReadLocalPositionCommand}" Padding="12,7" Margin="0,0,8,0"/><Button Content="管理坐标" Click="TeleportPage_Click" Padding="12,7"/><TextBlock Text="快捷传送作用于本机玩家" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding TeleportPoints}" SelectedItem="{Binding SelectedTeleportPoint}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border CornerRadius="12" Padding="12" Margin="0,0,0,6" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1"><DockPanel><Button Content="传送" DockPanel.Dock="Right" Command="{Binding DataContext.TeleportSavedPointCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="12,7" Margin="8,0,0,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Group}" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><Button Content="将选中传送点加入当前面板" Command="{Binding AddTeleportToOverlayCommand}" HorizontalAlignment="Left" Padding="12,7"/><TextBlock Text="{Binding PositionStatus}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="参数预设"><Grid Margin="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,3" VerticalContentAlignment="Center" MaxLength="40" ToolTip="预设名称" AutomationProperties.Name="预设名称"/><Button Grid.Column="1" Content="保存当前参数" Command="{Binding SavePresetCommand}" Padding="12,7" Margin="8,0,0,0"/></Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border CornerRadius="12" Padding="12" Margin="0,0,0,6" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1"><DockPanel><Button Content="恢复参数" DockPanel.Dock="Right" Command="{Binding DataContext.LoadOverlayPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="12,7" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><WrapPanel><Button Content="将选中预设加入当前面板" Command="{Binding AddPresetToOverlayCommand}" Padding="12,7" Margin="0,0,8,6"/><Button Content="重命名预设" Command="{Binding RenamePresetCommand}" Padding="12,7" Margin="0,0,8,6"/><Button Content="删除预设" Command="{Binding DeletePresetCommand}" Padding="12,7" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="恢复预设会停用持续功能并载入参数；需要的功能请手动开启。" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding ExperienceStatus}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0">
            <Border Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10"><CheckBox Content="启用游戏悬浮窗" IsChecked="{Binding WidgetVisible}"/></Border>
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10"><StackPanel>
              <TextBlock Text="我的快捷面板" FontSize="14" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding OverlayPanels}" SelectedItem="{Binding SelectedOverlayPanel}" DisplayMemberPath="Name" Height="34" Margin="0,10,0,8" AutomationProperties.Name="选择快捷面板"/>
              <TextBox Text="{Binding OverlayPanelName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,3" VerticalContentAlignment="Center" MaxLength="40" ToolTip="面板名称" AutomationProperties.Name="面板名称"/>
              <WrapPanel Margin="0,8,0,0"><Button Content="新建面板" Command="{Binding CreateOverlayPanelCommand}" Padding="12,7" Margin="0,0,8,0"/><Button Content="重命名" Command="{Binding RenameOverlayPanelCommand}" Padding="12,7" Margin="0,0,8,0"/><Button Content="删除面板" Command="{Binding DeleteOverlayPanelCommand}" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}" Padding="12,7"/></WrapPanel>
            </StackPanel></Border>
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10"><StackPanel>
              <TextBlock Text="添加功能" FontSize="14" FontWeight="SemiBold"/>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding OverlayFeatureChoices}" SelectedItem="{Binding SelectedOverlayFeatureChoice}" DisplayMemberPath="Title" IsTextSearchEnabled="True" Height="34" AutomationProperties.Name="选择要添加的功能"/><Button Grid.Column="1" Content="加入当前面板" Command="{Binding AddFeatureToOverlayCommand}" Padding="12,7" Margin="8,0,0,0"/></Grid>
              <TextBlock Text="传送点与参数预设可以在各自页签加入当前面板。" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel></Border>
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="14" Padding="14"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="展开 / 收起快捷键" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding OverlayHotkey, UpdateSourceTrigger=LostFocus}" Height="36" Padding="10,3" VerticalContentAlignment="Center" ToolTip="例如 Home、F8 或 Ctrl+Home；修改后离开输入框生效" AutomationProperties.Name="展开或收起快捷键"/></Grid>
              <TextBlock Text="支持窗口化和无边框全屏。展开时操作面板，收起后返回游戏。" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
              <TextBlock Text="Esc 收起 · Ctrl + Shift + F12 紧急停用" Foreground="{DynamicResource AccentDarkBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource GlassEdgeChromeBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,4,0"><TextBlock Text="{Binding OverlayStatus}" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" ToolTip="{Binding OverlayStatus}"/></Border>
          <Thumb Grid.Column="1" Cursor="SizeNWSE" DragDelta="Resize_DragDelta" Width="20" Height="20" VerticalAlignment="Bottom" ToolTip="拖动调整面板大小" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M 6,16 L 16,6 M 11,16 L 16,11" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></ControlTemplate></Thumb.Template></Thumb>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
