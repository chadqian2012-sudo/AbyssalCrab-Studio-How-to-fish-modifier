<UserControl x:Class="HowToFishTrainer.App.FunExperiencePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:HowToFishTrainer.App">
  <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,8,0,0">
    <Expander Header="自动补充与旋转设置"><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="海鸥耗尽后补充" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><CheckBox Content="开启自动补充" IsChecked="{Binding AutoRefill}" VerticalAlignment="Center"/><TextBlock Text="波次上限" Margin="12,0,8,0" VerticalAlignment="Center" Style="{StaticResource Muted}"/><app:NumericInputBox Width="85" Input="{Binding RefillLimitInput}"/></StackPanel><TextBlock Text="{Binding AutoRefillStatus}" Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="18,0"><TextBlock Text="大陀螺转速曲线" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SpinCurves}" SelectedItem="{Binding SpinCurve}" Margin="0,7,0,0"/><TextBlock Text="在玩家状态中开启大陀螺后生效；始终保持 2–15 圈/秒" Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="停止补充与旋转" Command="{Binding StopFunCommand}"/><TextBlock Text="{Binding FunEventsPage.SessionSpawnedCount,StringFormat=本次累计生成：{0}}" Style="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel>
    </Grid></Expander>
  </Border>
</UserControl>
