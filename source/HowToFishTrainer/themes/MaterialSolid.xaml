<?xml version="1.0" encoding="utf-8"?>
<!--
  ===========================================================================
  AbyssalCrab Studio · Themes/MaterialSolid.xaml（实色材质降级档）
  ===========================================================================
  · 用途：在低渲染能力、远程桌面等场景下，把"玻璃"换成不透明实色面：
    没有渐变着色、没有背景光晕、没有透明叠层，只保留清晰的边框与层次。
    可读性优先，视觉识别色（#466E7D 系）不变。
  · 触发：App.xaml.cs 的 ApplyMaterialFallback()，依据 RenderCapability.Tier
    与 SystemParameters 的真实取值决定是否在启动时合并（必须在任何窗口创建之前）。
  · 键名与主题里的玻璃 token 完全同名，因此窗口与卡片用 DynamicResource
    引用时会被整站替换；颜色/尺寸/业务 token 一律不覆盖。
  · 半透明全部去掉：这些面在任意背景上都得到确定的对比度。
  ===========================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 画布：单一冷灰实色 -->
  <SolidColorBrush x:Key="GlassCanvasBrush" Color="#EEF3F6" />

  <!-- 光晕：降级档直接不画（透明填充，视觉树结构不变） -->
  <SolidColorBrush x:Key="GlassHaloAccentBrush" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="GlassHaloWarmBrush" Color="#00FFFFFF" />

  <!-- 工具层 / 导航层 / 卡片：三档由浅到白，靠明度而不是透明度分层 -->
  <SolidColorBrush x:Key="GlassChromeBrush" Color="#F7FAFB" />
  <SolidColorBrush x:Key="GlassNavBrush" Color="#F2F6F8" />
  <SolidColorBrush x:Key="GlassCardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="GlassNavCapsuleBrush" Color="#FFFFFF" />

  <!-- 边线：单一实色，上/侧/工具层统一，不再有上亮下柔的渐变高光 -->
  <SolidColorBrush x:Key="GlassEdgeHBrush" Color="#C3D2D9" />
  <SolidColorBrush x:Key="GlassEdgeVBrush" Color="#C3D2D9" />
  <SolidColorBrush x:Key="GlassEdgeChromeBrush" Color="#C3D2D9" />

  <!-- 顶边镜面高光：降级档压到几乎不可见的一层白。
       高对比/减少透明度的诉求是"边界清楚"，不是"没有边界"，
       所以这里不置零，只是把光学高光收成一条极淡的实色。 -->
  <SolidColorBrush x:Key="GlassSpecularBrush" Color="#26FFFFFF" />

  <!-- 阴影：降级档只留最轻的一层，避免在低端 GPU 上多花合成开销 -->
  <DropShadowEffect x:Key="GlassShadowSoft" BlurRadius="6" ShadowDepth="1" Direction="270"
                    Color="#3D5A6B78" Opacity="0.06" RenderingBias="Performance" />
  <DropShadowEffect x:Key="GlassShadowRaised" BlurRadius="10" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.10" RenderingBias="Performance" />
  <DropShadowEffect x:Key="GlassShadowChrome" BlurRadius="6" ShadowDepth="1" Direction="270"
                    Color="#3D5A6B78" Opacity="0.05" RenderingBias="Performance" />
  <!-- 外壳高程落影：降级档收到很窄很淡，只保留"面板与衬底有分界"这一点信息 -->
  <DropShadowEffect x:Key="GlassShadowWindow" BlurRadius="8" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.10" RenderingBias="Performance" />
</ResourceDictionary>
