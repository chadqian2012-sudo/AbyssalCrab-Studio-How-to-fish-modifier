<?xml version="1.0" encoding="utf-8"?>
<!--
  ===========================================================================
  AbyssalCrab Studio · Themes/MaterialTinted.xaml（着色玻璃档 · 默认）
  ===========================================================================
  · 三档材质强度之一：实色( MaterialSolid ) / 着色玻璃( 本文件，默认 ) / 通透( 主题原值 )
    交接文档 §7.3 要求"默认偏可读的着色玻璃"，所以启动时默认合并本文件；
    用户可在顶栏的「材质」菜单里切换，选择持久化到独立 UI 设置文件。
  · 键名与主题里的玻璃 token 完全同名，用 DynamicResource 引用即可整站替换。
  · 只覆盖材质 token（画布/工具层/导航/卡片/胶囊/边线/阴影），
    颜色识别色、圆角、字号、间距、动效 token 一律不覆盖。
  · 相对"通透"档的做法：把每个面的不透明度往上提一档，边线更实，
    阴影略收 —— 结果是文字背后更干净，但仍有渐变与层次，不是实色。
  ===========================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 画布：比通透档略沉一点，给玻璃提供稳定的底 -->
  <LinearGradientBrush x:Key="GlassCanvasBrush" StartPoint="0,0" EndPoint="0.35,1">
    <GradientStop Color="#EDF3F7" Offset="0" />
    <GradientStop Color="#E5EDF2" Offset="0.55" />
    <GradientStop Color="#DDE7ED" Offset="1" />
  </LinearGradientBrush>

  <!-- 光晕：保留但更克制，避免和更实的卡片抢视线 -->
  <RadialGradientBrush x:Key="GlassHaloAccentBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
    <GradientStop Color="#3D7FA3B4" Offset="0" />
    <GradientStop Color="#007FA3B4" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="GlassHaloWarmBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
    <GradientStop Color="#29C6B9A6" Offset="0" />
    <GradientStop Color="#00C6B9A6" Offset="1" />
  </RadialGradientBrush>

  <!-- 工具层 / 导航：仍明显通透，但文字背后更干净 -->
  <LinearGradientBrush x:Key="GlassChromeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F2FAFCFD" Offset="0" />
    <GradientStop Color="#E6F2F7FA" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassNavBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EEF6FAFC" Offset="0" />
    <GradientStop Color="#DEF0F6F9" Offset="1" />
  </LinearGradientBrush>

  <!-- 卡片：接近不透明白的磨砂面，长说明文字优先可读 -->
  <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EEFFFFFF" Offset="0" />
    <GradientStop Color="#E4F3F8FB" Offset="1" />
  </LinearGradientBrush>

  <!-- 胶囊：比导航再实一点，保持"浮起来"的感觉 -->
  <LinearGradientBrush x:Key="GlassNavCapsuleBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EEFFFFFF" Offset="0" />
    <GradientStop Color="#E8F2F7FA" Offset="1" />
  </LinearGradientBrush>

  <!-- 边线：略比通透档实，保证圆角轮廓清晰 -->
  <LinearGradientBrush x:Key="GlassEdgeHBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#D9FFFFFF" Offset="0" />
    <GradientStop Color="#59A0B8C4" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdgeVBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#6BADC2CD" Offset="0" />
    <GradientStop Color="#4D9DB4C0" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdgeChromeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#CCFFFFFF" Offset="0" />
    <GradientStop Color="#4DA6BCC7" Offset="1" />
  </LinearGradientBrush>

  <!-- 顶边镜面高光：与主题同值。着色玻璃档是默认档，镜面保持"看得见但不刺眼" -->
  <LinearGradientBrush x:Key="GlassSpecularBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#B3FFFFFF" Offset="0" />
    <GradientStop Color="#66FFFFFF" Offset="0.42" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- 阴影：与通透档一致，材质与阴影是两件事 -->
  <DropShadowEffect x:Key="GlassShadowSoft" BlurRadius="12" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.075" RenderingBias="Performance" />
  <DropShadowEffect x:Key="GlassShadowRaised" BlurRadius="24" ShadowDepth="3" Direction="270"
                    Color="#3D5A6B78" Opacity="0.12" RenderingBias="Performance" />
  <DropShadowEffect x:Key="GlassShadowChrome" BlurRadius="18" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.07" RenderingBias="Performance" />
  <!-- 外壳高程落影：着色档是默认档，保持与主题同值 -->
  <DropShadowEffect x:Key="GlassShadowWindow" BlurRadius="9" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.18" RenderingBias="Performance" />
</ResourceDictionary>
