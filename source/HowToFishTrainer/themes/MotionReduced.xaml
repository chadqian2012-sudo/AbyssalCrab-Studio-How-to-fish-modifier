<?xml version="1.0" encoding="utf-8"?>
<!--
  ===========================================================================
  AbyssalCrab Studio · Themes/MotionReduced.xaml（减少动画降级档）
  ===========================================================================
  · 只在启动时按系统信号（SystemParameters.ClientAreaAnimation）决定是否合并，
    见 App.xaml.cs 的 ApplyMotionPreference。
  · 这里把主题里的 Motion* 时长 token 全部覆盖为 0，于是所有 123 条动画都变成
    "立即到终值"：界面仍然正确，只是不再有过渡过程。
  · 关键约束（交接文档 §10.8）：紧急停用、关闭、失败提示本来就不受动画门控，
    这里把时长归零只会让它们更快可见，不会产生延迟。
  · 只覆盖时长，不覆盖任何颜色/材质/尺寸 token，也不改任何业务资源。
    因此本文件对视觉识别色、功能与协议零影响。
  ===========================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Duration x:Key="MotionPress">0:0:0</Duration>
  <Duration x:Key="MotionHover">0:0:0</Duration>
  <Duration x:Key="MotionRelease">0:0:0</Duration>
  <Duration x:Key="MotionFocus">0:0:0</Duration>
  <Duration x:Key="MotionSelect">0:0:0</Duration>
  <Duration x:Key="MotionPage">0:0:0</Duration>
  <Duration x:Key="MotionSwitch">0:0:0</Duration>
  <Duration x:Key="MotionStatus">0:0:0</Duration>
  <Duration x:Key="MotionExpand">0:0:0</Duration>
  <Duration x:Key="MotionPopup">0:0:0</Duration>
</ResourceDictionary>
