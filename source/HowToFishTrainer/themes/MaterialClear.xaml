<?xml version="1.0" encoding="utf-8"?>
<!--
  ===========================================================================
  AbyssalCrab Studio · Themes/MaterialClear.xaml（通透玻璃档）
  ===========================================================================
  · 三档材质强度之一：实色( MaterialSolid ) / 着色玻璃( MaterialTinted，默认 ) / 通透( 本文件 )
    交接文档 §7.3 要求“默认偏可读的着色玻璃”，所以默认不是本档；
    本档是透明度最高、玻璃感最强的一档，由用户在顶栏「材质」菜单里选择。
  · 这些值原本就是主题里的取值，现在把它们移到独立档，
    主题自身改为默认的着色玻璃取值。值本身未改变。
  · 只覆盖材质 token，颜色识别色/圆角/字号/间距/动效 token 一律不动。
  ===========================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <LinearGradientBrush x:Key="GlassCanvasBrush" StartPoint="0,0" EndPoint="0.35,1">
    <GradientStop Color="#EFF5F8" Offset="0" />
    <GradientStop Color="#E8F0F4" Offset="0.55" />
    <GradientStop Color="#E1EBF0" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GlassChromeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EAF6FAFC" Offset="0" />
    <GradientStop Color="#D6EDF4F8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GlassNavBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E4F3F8FB" Offset="0" />
    <GradientStop Color="#CFEAF2F7" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GlassNavCapsuleBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F2FFFFFF" Offset="0" />
    <GradientStop Color="#DCEAF2F6" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GlassEdgeHBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E0FFFFFF" Offset="0" />
    <GradientStop Color="#66A0B8C4" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GlassEdgeVBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#7FB0C5D0" Offset="0" />
    <GradientStop Color="#5C9DB4C0" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GlassEdgeChromeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#BFFFFFFF" Offset="0" />
    <GradientStop Color="#40A6BCC7" Offset="1" />
  </LinearGradientBrush>

  <!-- 顶边镜面高光：通透档比着色档再亮一档，符合"玻璃越透、光学边越明显"的直觉 -->
  <LinearGradientBrush x:Key="GlassSpecularBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#D9FFFFFF" Offset="0" />
    <GradientStop Color="#80FFFFFF" Offset="0.42" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <RadialGradientBrush x:Key="GlassHaloAccentBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
    <GradientStop Color="#4A82A6B8" Offset="0" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </RadialGradientBrush>

  <RadialGradientBrush x:Key="GlassHaloWarmBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
    <GradientStop Color="#33C6B9A6" Offset="0" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </RadialGradientBrush>

  <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F7FFFFFF" Offset="0" />
    <GradientStop Color="#F0F5F9FB" Offset="1" />
  </LinearGradientBrush>

  <DropShadowEffect x:Key="GlassShadowSoft" BlurRadius="12" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.075" RenderingBias="Performance" />
  <DropShadowEffect x:Key="GlassShadowRaised" BlurRadius="24" ShadowDepth="3" Direction="270"
                    Color="#3D5A6B78" Opacity="0.12" RenderingBias="Performance" />
  <DropShadowEffect x:Key="GlassShadowChrome" BlurRadius="18" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.07" RenderingBias="Performance" />
  <DropShadowEffect x:Key="GlassShadowWindow" BlurRadius="9" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.18" RenderingBias="Performance" />
</ResourceDictionary>
