            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 6.6 WindowButton：保持 42×34 外形，改为图标按钮质感（底色 MotionHover 过渡）；
       关闭键（Foreground = DangerBrush，由 MainWindow 设置）悬停转 DangerSoftBrush 底 -->
  <Style x:Key="WindowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="3,0,0,0" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Grid.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border Name="Surface"
                    Background="{TemplateBinding Control.Background}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}"
                    BorderThickness="{TemplateBinding Control.BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}" />
            <Border Name="HoverFill" Background="{StaticResource HoverBrush}" CornerRadius="{StaticResource RadiusControl}"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="CloseFill" Background="{StaticResource DangerSoftBrush}" CornerRadius="{StaticResource RadiusControl}"
                    Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionHover}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionHover}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- 关闭键：悬停且文字为 DangerBrush（同一实例，引用相等即命中） -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="True" />
                <Condition Property="Control.Foreground" Value="{StaticResource DangerBrush}" />
              </MultiTrigger.Conditions>
              <MultiTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CloseFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CloseFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.94" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.94" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseStandard}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseStandard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =======================================================================
       7. 输入与选择
       ======================================================================= -->

  <!-- 7.0 ProgressBar：生命/饱食度/属性条原先走原生模板（直角 + 数值变化时白色高光扫过），
       和圆角卡片不是一套。这里改成圆角轨道 + 圆角填充。
       颜色仍由调用处的 Foreground 决定（成功绿 / 金色 / 主色），不引入新色。
       不自行设置 PART_Indicator 的宽度：WPF 的 ProgressBar 会按 Value/Maximum 自动算，
       所以保留原生机制，只替换外观。 -->
  <Style x:Key="{x:Type ProgressBar}" TargetType="{x:Type ProgressBar}">
    <Setter Property="Background" Value="{StaticResource ProgressTrackBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid Name="Root">
            <Border Name="PART_Track"
                    Background="{TemplateBinding Control.Background}"
                    CornerRadius="4" />
            <Border Name="PART_Indicator"
                    HorizontalAlignment="Left"
                    Background="{TemplateBinding Control.Foreground}"
                    CornerRadius="4" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 7.1 TextBox：8px 圆角、白面、FieldLineBrush 边线；聚焦时边线转 AccentBrush
       + 3px 极浅外发光（第二层 Border + Opacity 动画，不用 Effect 动画）。
       绑定更新触发方式不变（模板不涉及 UpdateSourceTrigger）。 -->
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FrameworkElement.Cursor" Value="IBeam" />
    <!-- 键盘焦点环：原先只有 1px FocusLine + 3px Glow，且鼠标聚焦也会亮，
         键盘用户分不清"焦点在哪、是不是键盘焦点"。这里补一个 2px 的 FocusVisualStyle
         （只在键盘聚焦时出现），与悬停/鼠标聚焦的浅色提示区分开；
         它画在 AdornerLayer 上，不参与布局、不吃命中，也不随控件 Opacity 变淡。 -->
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="#BCD0D8" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid SnapsToDevicePixels="True">
            <Border Name="Glow" Margin="-3" CornerRadius="{StaticResource RadiusField}"
                    BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="3"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="Surface"
                    Background="{TemplateBinding Control.Background}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}"
                    BorderThickness="{TemplateBinding Control.BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}"
                    Padding="{TemplateBinding Control.Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
            </Border>
            <Border Name="HoverLine" CornerRadius="{StaticResource RadiusControl}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="FocusLine" CornerRadius="{StaticResource RadiusControl}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    Opacity="0" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                     To="0.55" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 7.2 ComboBox：与 TextBox 同族外观；完整自定义模板，保留标准行为
       （IsEditable / PART_EditableTextBox、下拉 PART_Popup、键盘导航、ItemContainer） -->
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid Name="Root" SnapsToDevicePixels="True">
            <Border Name="Surface"
                    Background="{TemplateBinding Control.Background}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}"
                    BorderThickness="{TemplateBinding Control.BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}" />
            <Border Name="HoverFill" Background="{StaticResource HoverBrush}" CornerRadius="{StaticResource RadiusControl}"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="FocusLine" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Opacity="0" IsHitTestVisible="False" />
            <Grid Margin="{TemplateBinding Control.Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- ContentSource="Content" 与下面这几个绑定缺一不可：少了它们，ComboBox 会忽略
                   DisplayMemberPath，直接把选中项 ToString() 画出来（记录类型会显示成
                   "AttachmentOption { Id = …, Name = … }"）。 -->
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding ComboBox.SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ComboBox.ItemTemplateSelector}"
                                ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}"
                                ContentSource="Content"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Control.Foreground}" />
              <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                       Style="{x:Null}" Focusable="True"
                       Visibility="Hidden"
                       IsReadOnly="{TemplateBinding ComboBox.IsReadOnly}"
                       Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                       Foreground="{TemplateBinding Control.Foreground}"
                       VerticalContentAlignment="Center"
                       HorizontalScrollBarVisibility="Hidden"
                       VerticalScrollBarVisibility="Hidden">
                <TextBox.Template>
                  <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                  </ControlTemplate>
                </TextBox.Template>
              </TextBox>
              <Path x:Name="Arrow" Grid.Column="1"
                    Data="M 0,0 L 4.5,4.5 L 9,0"
                    Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="8,2,2,0" IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0" />
                </Path.RenderTransform>
              </Path>
              <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2"
                            Focusable="False" ClickMode="Press"
                            Background="Transparent" BorderThickness="0"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
            </Grid>
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                   AllowsTransparency="True" PopupAnimation="None" Focusable="False"
                   IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}">
              <!-- 下拉面之前是 CardBrush + LineBrush + ShadowRaised 的静态白盒：在玻璃界面里
                   就是一块不透明白，而且完全不跟随 Solid/Tinted/Clear 材质档。
                   这里换成 DynamicResource 的玻璃材质键（只有 DynamicResource 会被材质档整站替换）。
                   PopupAnimation="Fade" 走的是系统动画、不受 MotionReduced 影响，
                   改为 None + 下面这段令牌驱动的入场（Opacity + 6→0 位移，MotionPopup + EaseEnter）。
                   入场动画挂在 Border 自己的 Style/DataTrigger 上、目标就是该 Border 本身，
                   不写 TargetName：既避开 Popup 内元素的名字域解析风险，也不碰命中与键盘导航
                   （只动 Opacity 与 TranslateTransform.Y，不延迟任何命令处理）。
                   基线 Opacity=1 / Y=0，即使动画不播（减少动画时 Duration 归零）下拉也完整可见。 -->
              <Border Name="DropDownBorder"
                      MinWidth="{TemplateBinding FrameworkElement.ActualWidth}"
                      MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}"
                      Margin="0,0,12,12" Padding="4"
                      Background="{DynamicResource GlassCardBrush}"
                      BorderBrush="{DynamicResource GlassEdgeHBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusField}"
                      Effect="{DynamicResource GlassShadowRaised}"
                      Opacity="1" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                  <TranslateTransform Y="0" />
                </Border.RenderTransform>
                <Border.Style>
                  <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Value="True">
                        <DataTrigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="0" To="1" FillBehavior="Stop"
                                               Duration="{StaticResource MotionPopup}" EasingFunction="{StaticResource EaseEnter}" />
                              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                               From="6" To="0" FillBehavior="Stop"
                                               Duration="{StaticResource MotionPopup}" EasingFunction="{StaticResource EaseEnter}" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ComboBox.IsDropDownOpen" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Arrow"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     To="180" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseStandard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Arrow"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     To="0" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseStandard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ComboBox.IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="UIElement.Visibility" Value="Visible" />
              <Setter TargetName="ContentSite" Property="UIElement.Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 7.3 ComboBoxItem：下拉项（悬停 HoverBrush，选中 AccentSoftBrush） -->
  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <!-- 下拉项原先没有任何焦点视觉：键盘上下选择时看不出焦点落在哪一项。
         补 2px FocusRing（仅键盘聚焦出现），与 IsHighlighted 的 HoverFill 区分开。 -->
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Grid MinHeight="30" SnapsToDevicePixels="True">
            <Border Name="Surface" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Margin="2" />
            <Border Name="HoverFill" Background="{StaticResource HoverBrush}" CornerRadius="{StaticResource RadiusControl}" Margin="2"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="SelFill" Background="{StaticResource AccentSoftBrush}" CornerRadius="{StaticResource RadiusControl}" Margin="2"
                    Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
              <Setter TargetName="HoverFill" Property="UIElement.Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Selector.IsSelected" Value="True">
              <Setter TargetName="SelFill" Property="UIElement.Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 7.4 CheckBox：16×16、圆角 4、选中填充 AccentBrush + 白色对勾（150ms 过渡） -->
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 复选框视觉核心：16x16 圆角方框 + 白勾/短横。
                 方框与右侧文字必须使用同一个垂直对齐来源（控件的 VerticalContentAlignment），
                 否则在高于 16px 的容器里方框居中、文字贴顶，视觉上就是"方框没贴合文字"。
                 默认值 Center 由 WPF 的 CheckBox 提供，两种状态在 16px / 60px 容器下都对齐。 -->
            <Grid x:Name="BoxHost" Width="16" Height="16"
                  HorizontalAlignment="Left" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                  RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </Grid.RenderTransform>
              <Border Name="Box" CornerRadius="4"
                      Background="{StaticResource FieldBrush}"
                      BorderBrush="{StaticResource FieldLineBrush}"
                      BorderThickness="1" />
              <Border Name="BoxHover" CornerRadius="4"
                      BorderBrush="{StaticResource AccentLineBrush}"
                      BorderThickness="1" Opacity="0" />
              <Border Name="BoxFill" CornerRadius="4"
                      Background="{StaticResource AccentBrush}" Opacity="0" />
              <Path Name="Check" Data="M 3.4,8.2 L 6.5,11.2 L 12.6,5.1"
                    Stroke="#FFFFFFFF" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" />
              <Path Name="Dash" Data="M 4,8 L 12,8"
                    Stroke="#FFFFFFFF" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" />
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="7,0,0,0"
                              VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="BoxFill" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="Check" Property="UIElement.Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="{x:Null}">
              <!-- 半选原先只有裸 Setter，勾选态却有动画，两态切换的观感不一致。
                   这里补上与勾选态同构的 Opacity 过渡（静态 Setter 仍作初始兜底）。 -->
              <Setter TargetName="BoxFill" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="Dash" Property="UIElement.Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Dash" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Dash" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoxHost"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.9" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="BoxHost"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.9" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoxHost"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSwitch}" />
                    <DoubleAnimation Storyboard.TargetName="BoxHost"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSwitch}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 7.5 ScrollBar：宽/高 10、滑块圆角 5 #D6DEE1、悬停 AccentLineBrush、无箭头按钮；
       同一模板同时支持 Vertical / Horizontal（Track 方向 + Page 命令随方向切换） -->
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Width" Value="10" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Name="Root" Background="{TemplateBinding Control.Background}">
            <Track x:Name="PART_Track" Focusable="False"
                   Orientation="{TemplateBinding ScrollBar.Orientation}"
                   IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="PageDecrease" Command="ScrollBar.PageUpCommand"
                              Focusable="False" IsTabStop="False" Opacity="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Thumb">
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Grid Margin="2" Background="Transparent">
                        <Border Name="Bar" CornerRadius="5" Background="#D6DEE1" />
                        <Border Name="BarHover" CornerRadius="5"
                                Background="{StaticResource AccentLineBrush}" Opacity="0" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Trigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="BarHover" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.EnterActions>
                          <Trigger.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="BarHover" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Thumb.IsDragging" Value="True">
                          <Setter TargetName="BarHover" Property="UIElement.Opacity" Value="1" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="PageIncrease" Command="ScrollBar.PageDownCommand"
                              Focusable="False" IsTabStop="False" Opacity="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ScrollBar.Orientation" Value="Vertical">
              <Setter TargetName="Thumb" Property="FrameworkElement.MinHeight" Value="18" />
            </Trigger>
            <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="Track.IsDirectionReversed" Value="False" />
              <Setter TargetName="PageDecrease" Property="ButtonBase.Command" Value="ScrollBar.PageLeftCommand" />
              <Setter TargetName="PageIncrease" Property="ButtonBase.Command" Value="ScrollBar.PageRightCommand" />
              <Setter TargetName="Thumb" Property="FrameworkElement.MinWidth" Value="18" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- =======================================================================
       8. 列表 / 导航（切换选项动画）
       ======================================================================= -->

  <!-- 8.1 NavListItem：最小高度 44px、左侧 3px 主色指示条（EaseSwitch 展开）、
       选中底色 180ms 过渡、文字颜色过渡到 AccentDarkBrush、悬停 HoverBrush、
       按下轻微缩放。29×29 图标底与 13px 半粗标题由 MainWindow 的 ItemTemplate
       提供（同一 ItemContainerStyle 不得重复渲染内容）。 -->
  <Style x:Key="NavListItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Padding" Value="20,12" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Name="Root" MinHeight="44" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Grid.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
              <Border Name="Surface" Background="Transparent" CornerRadius="{StaticResource RadiusNav}" Margin="6,2,8,2" />
              <Border Name="HoverFill" Background="{StaticResource HoverBrush}" CornerRadius="{StaticResource RadiusNav}" Margin="6,2,8,2"
                    Opacity="0" IsHitTestVisible="False" />
              <Border Name="SelFill" Background="{StaticResource AccentWashBrush}" CornerRadius="{StaticResource RadiusNav}" Margin="6,2,8,2"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="Indicator" Width="3" HorizontalAlignment="Left" Margin="6,9,0,9"
                    CornerRadius="0,2,2,0" Background="{StaticResource AccentBrush}"
                    RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="0" ScaleY="1" />
              </Border.RenderTransform>
            </Border>
            <ContentPresenter Name="Content" Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                              VerticalAlignment="Center">
              <TextElement.Foreground>
                <SolidColorBrush Color="#251F2A" />
              </TextElement.Foreground>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Indicator"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionExpand}" EasingFunction="{StaticResource EaseSwitch}" />
                    <ColorAnimation Storyboard.TargetName="Content"
                                    Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                    To="#32525E" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Indicator"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <ColorAnimation Storyboard.TargetName="Content"
                                    Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                    To="#251F2A" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.98" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.98" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseStandard}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseStandard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 8.2 OptionListItem：长列表选项（实时目录 / 分类 / 传送点 / 岛屿 / 成员）。
       选中：AccentWashBrush 底 + 左侧 3px 指示条（ScaleX 展开，EaseSwitch）+ 文字
       AccentDarkBrush；悬停 HoverBrush；指示条与底色都是动画而非瞬间切换。 -->
  <Style x:Key="OptionListItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Name="Root" MinHeight="32" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Grid.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border Name="Surface" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Margin="1,0,1,0" />
            <Border Name="HoverFill" Background="{StaticResource HoverBrush}" CornerRadius="{StaticResource RadiusControl}" Margin="1,0,1,0"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="SelFill" Background="{StaticResource AccentWashBrush}" CornerRadius="{StaticResource RadiusControl}" Margin="1,0,1,0"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="Indicator" Width="3" HorizontalAlignment="Left" Margin="1,5,0,5"
                    CornerRadius="0,2,2,0" Background="{StaticResource AccentBrush}"
                    RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="0" ScaleY="1" />
              </Border.RenderTransform>
            </Border>
            <ContentPresenter Name="Content" Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                              VerticalAlignment="Center">
              <TextElement.Foreground>
                <SolidColorBrush Color="#251F2A" />
              </TextElement.Foreground>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Indicator"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionExpand}" EasingFunction="{StaticResource EaseSwitch}" />
                    <ColorAnimation Storyboard.TargetName="Content"
                                    Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                    To="#32525E" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Indicator"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                    <ColorAnimation Storyboard.TargetName="Content"
                                    Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                    To="#251F2A" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.99" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.99" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseStandard}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseStandard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 8.3 ChipListItem：紧凑药丸（分类 / 稀有度 / 轮盘选项）。
       选中：AccentBrush 底 + 白字（底色 MotionRelease 过渡 + 轻微缩放回弹）；按下 0.98。 -->
  <Style x:Key="ChipListItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Grid.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border Name="Surface" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusChip}" />
            <Border Name="HoverFill" Background="{StaticResource HoverBrush}" CornerRadius="{StaticResource RadiusChip}"
                    Opacity="0" IsHitTestVisible="False" />
            <Border Name="SelFill" Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusChip}"
                    Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter Name="Content" Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextElement.Foreground>
                <SolidColorBrush Color="#251F2A" />
              </TextElement.Foreground>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <ColorAnimation Storyboard.TargetName="Content"
                                    Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                    To="#FFFFFF" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.96" To="1" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSwitch}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.96" To="1" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSwitch}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <!-- 退出与进入用同一组时长/缓动（MotionRelease + EaseSoft），不再一快一慢。 -->
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <ColorAnimation Storyboard.TargetName="Content"
                                    Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                    To="#251F2A" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- 按下反馈：原先 ChipListItem 只有悬停与选中，按下毫无回应。
                 补一个与 OptionListItem 同构的按下态（0.98 + 释放回 1）。 -->
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.98" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.98" Duration="{StaticResource MotionPress}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseStandard}" />
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseStandard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 8.4 OptionListBox：透明底、无边框、隐藏横向滚动条、虚拟化 + Recycling -->
  <Style x:Key="OptionListBox" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource OptionListItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
  </Style>

  <!-- =======================================================================
       9. 卡片与标签
       ======================================================================= -->

  <!-- 9.1 FeatureCardStyle：玻璃磨砂卡片。
       层级圆角 18（RadiusCard），静态渐变玻璃面 GlassCardBrush（比导航层更实，
       保证长说明文字可读），细边缘高光 GlassEdgeBrush，阴影换成更淡更宽的 GlassShadowSoft。
       悬停只换投影 + 1px 抬升；不动 BorderBrush，避免与 MainWindow 里基于 RiskLabel 的
       DataTrigger（危险卡片 #E8A6AE 边线）互相覆盖。
       MinHeight 保留 132，但要说明它并不是卡片高度的决定因素：普通功能卡的实际高度由内容
       撑出（状态行含 32px 高的开关，内容约 129px）+ 上下内边距 + 下外边距。实测把 MinHeight
       清零甚至设成 1，卡片高度不变，所以 MinHeight 只是兜底，不是密度旋钮。 -->
  <Style x:Key="FeatureCardStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeHBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Border.Padding" Value="16,12" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="MinHeight" Value="132" />
    <Setter Property="UIElement.Effect" Value="{DynamicResource GlassShadowSoft}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <!-- 抬升用的可动画变换不再由 Style Setter 提供：Style Setter 里的 Freezable 会被 Style.Seal()
         冻结且被所有卡片共享，对它做 (UIElement.RenderTransform).(TranslateTransform.Y) 动画会抛
         InvalidOperationException（"该对象已密封或已冻结"）。
         改由 CardLiftTransform.Enable 附加行为给每张卡安装一份**独享**的 TranslateTransform(0,0)，
         主题的悬停动画因此拿到合法、可写的目标（见 App/CardLiftTransform.cs）。
         这里删掉 RenderTransform Setter 是安全的：卡片侧没有任何一处挂本地 RenderTransform，
         行为回调会把 RenderTransform 从 null 补上 TranslateTransform。 -->
    <Setter Property="app:CardLiftTransform.Enable" Value="True" />
    <!-- 说明：Border 不是 Control，没有 Template，所以做不了 rim+inset 双层模板
         （实测 MC4005）。理论更优的写法是给每张卡再包一层内层 Border 来画连续边缘高光，
         但那要改 MainWindow 里 12 处卡片用法并嵌套全部内容，改动面与收益不成比例。
         复核了 6 倍放大的实际转角（verification/polish/corner-card-topleft.png）：
         18px 圆角 + 1px 描边下上缘高光沿弧线是连续的，没有出现研究与探针里那种"脱节"。
         因此这里保持单层 Border，改为把描边对比提上去，让边缘高光在各个方向都读得出来。 -->
    <Style.Triggers>
      <!-- 悬停：投影仍是静态替换（Effect 是共享 Freezable，动画它本身就会抛冻结异常）。
           阴影变化保持瞬时是已记录的取舍 —— 平滑的位移现在承担了交互反馈。
           抬升改为真正的动画：目标 (UIElement.RenderTransform).(TranslateTransform.Y) 由上面的
           CardLiftTransform.Enable 附加行为为每张卡单独安装 TranslateTransform，路径因此可解析。
           绝不能用 Setter 去替换 RenderTransform —— 那会让正在运行的动画失去目标，平滑位移退化成跳变
           （与 FeatureSwitch 里记录的是同一条规则）。 -->
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="UIElement.Effect" Value="{DynamicResource GlassShadowRaised}" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <!-- 默认 FillBehavior（HoldEnd）：悬停期间保持抬升。 -->
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                               To="-2" Duration="{StaticResource MotionHover}" EasingFunction="{StaticResource EaseStandard}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <!-- 退出用 FillBehavior="Stop" 释放时钟，Y 回到基础值 0；基础值正是退出目标，故无视觉跳变
                   （与 PageFadeIn 的处理一致）。 -->
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                               To="0" FillBehavior="Stop" Duration="{StaticResource MotionHover}" EasingFunction="{StaticResource EaseStandard}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 9.2 Pill：药丸标签（圆角取 RadiusChip=16、内边距 8,3、AccentSoftBrush 底） -->
  <Style x:Key="Pill" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Border.CornerRadius" Value="{StaticResource RadiusChip}" />
    <Setter Property="Border.Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- =======================================================================
       10. FeatureSwitch（68×32，可动效开关）
         · 轨道：椭圆（CornerRadius 16）；关 #E2E7E9、开 AccentBrush，220ms 颜色过渡
           —— 用两层轨道叠层 + Opacity 动画实现（见文件头说明：主题画刷会被冻结，
              对它们做 Color 动画会抛 InvalidOperationException）。
         · 白色圆形滑块：TranslateTransform.X 0 → 36 位移动画（EaseSwitch 回弹，220ms），
           不再用 HorizontalAlignment/Margin 触发器瞬间跳变。
         · 开/关 文字：两个 TextBlock 交叉淡入淡出（Opacity + ScaleTransform）。
         · 悬停：轨道轻微提亮（白色 Sheen 层 0.10）；禁用：整体 Opacity 0.42。
       ======================================================================= -->
  <Style x:Key="FeatureSwitch" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="68" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="#E2E7E9" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusRingPill}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <!-- 可动画的轨道画笔：模板私有资源，避免直接动画主题画刷（冻结） -->
          <ControlTemplate.Resources>
            <SolidColorBrush x:Key="SwitchTrackOff" Color="#E2E7E9" />
            <SolidColorBrush x:Key="SwitchTrackOn" Color="#466E7D" />
          </ControlTemplate.Resources>
          <Grid Name="Root" Width="68" Height="32" Background="Transparent">
            <Border Name="Track" Background="{StaticResource SwitchTrackOff}" CornerRadius="{StaticResource RadiusChip}" />
            <Border Name="TrackOn" Background="{StaticResource SwitchTrackOn}" CornerRadius="{StaticResource RadiusChip}" Opacity="0" />
            <Border Name="Sheen" Background="#FFFFFF" CornerRadius="{StaticResource RadiusChip}" Opacity="0" IsHitTestVisible="False" />
            <TextBlock Name="OffLabel" Text="关" Foreground="#6F787C" FontSize="10" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                       RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </UIElement.RenderTransform>
            </TextBlock>
            <TextBlock Name="OnLabel" Text="开" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"
                       Opacity="0" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
              </UIElement.RenderTransform>
            </TextBlock>
            <Ellipse Name="Thumb" Width="24" Height="24" Fill="#FFFFFFFF"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
              <UIElement.RenderTransform>
                <TranslateTransform X="0" />
              </UIElement.RenderTransform>
              <UIElement.Effect>
                <DropShadowEffect Color="#1B333B" BlurRadius="6" ShadowDepth="1" Opacity="0.2" />
              </UIElement.Effect>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <!-- 静态兜底：初始即勾选时也正确（不依赖加载期动画）。
                   注意：这里只对值类型属性（Opacity）做静态兜底，绝不能用 Setter 去替换
                   RenderTransform 这类 Freezable —— 替换实例会让正在运行的动画失去目标，
                   滑块位移动画会退化成瞬间跳变。透明度与位移的一致性由动画本身保证。 -->
              <Setter TargetName="TrackOn" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="OnLabel" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="OffLabel" Property="UIElement.Opacity" Value="0" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Thumb"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="36" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSwitch}" />
                    <DoubleAnimation Storyboard.TargetName="OffLabel" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="OffLabel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.86" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="OffLabel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.86" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="OnLabel" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="OnLabel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSwitch}" />
                    <DoubleAnimation Storyboard.TargetName="OnLabel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSwitch}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Thumb"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="0" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSwitch}" />
                    <DoubleAnimation Storyboard.TargetName="OnLabel" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="OnLabel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.86" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="OnLabel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.86" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="OffLabel" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionRelease}" EasingFunction="{StaticResource EaseSoft}" />
                    <DoubleAnimation Storyboard.TargetName="OffLabel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSwitch}" />
                    <DoubleAnimation Storyboard.TargetName="OffLabel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource MotionSwitch}" EasingFunction="{StaticResource EaseSwitch}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity"
                                     To="0.10" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
              <!-- 静态 Setter 兜底初始状态；过渡用 Opacity 动画（值类型，永不冻结）。
                   目标不写 TargetName，默认就是模板父级（控件自身）。 -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =======================================================================
       11. 页面切换动效（供 MainWindow 内容区触发）
       注意：目标元素的 RenderTransform 必须是 TranslateTransform，
       否则第二个动画的属性路径无法解析（建议 <TranslateTransform Y="0"/>）。

       这里默认的 FillBehavior=HoldEnd 会把动画时钟长期挂在 Opacity / TranslateTransform.Y 上，
       让内容区在动画结束后依然保持 HasAnimatedProperties=true。因为两条动画的终值 1 / 0
       恰好等于元素的静态基线值（Opacity 默认 1、TranslateTransform Y="0"），所以可以安全地
       把填充行为关掉，让时钟在结束帧自行释放，而不会产生任何视觉跳变。
       FillBehavior 需要逐条设在 DoubleAnimation 上：只设在 Storyboard 上不会下沉到子时间线。
       ======================================================================= -->
  <Storyboard x:Key="PageFadeIn">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0.72" To="1" FillBehavior="Stop"
                     Duration="{StaticResource MotionPage}" EasingFunction="{StaticResource EaseEnter}" />
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="6" To="0" FillBehavior="Stop"
                     Duration="{StaticResource MotionPage}" EasingFunction="{StaticResource EaseEnter}" />
  </Storyboard>

</ResourceDictionary>
