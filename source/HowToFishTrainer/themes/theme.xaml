                                     To="1" Duration="{StaticResource MotionStatus}" EasingFunction="{StaticResource EaseSoft}" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
