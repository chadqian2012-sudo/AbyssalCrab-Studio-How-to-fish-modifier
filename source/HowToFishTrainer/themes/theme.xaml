<?xml version="1.0" encoding="utf-8"?>
<!--
  ===========================================================================
  AbyssalCrab Studio V1.1.37 · Themes/Theme.xaml（UI 美化重写版 / 设计系统 + 动效基础）
  ===========================================================================
  · 纯 ResourceDictionary，由 App.xaml 以 <ResourceDictionary Source="Themes/Theme.xaml"/>
    合并，必须能被 Application.LoadComponent 作为 themes/theme.xaml 加载。
  · 配色令牌逐字沿用，未新增/修改任何识别色。
  · 全部动效 ≤ 260ms；颜色过渡用 Opacity 叠加层或可动画画笔，位移/滑块用
    TranslateTransform / ScaleTransform，缓动统一取 Ease* 资源。
  · 材质使用 DynamicResource，动效使用 WPF 原生时间线与时长 token；无第三方库。
  ===========================================================================
  动效令牌类型说明（契约 §4）：
    EaseStandard / EaseEnter / EaseExit / EaseSwitch / EaseSoft 为 Freezable，
    以对象元素形式声明（<CubicEase .../>），可供任意 XAML 用 {StaticResource} 引用。
    DurationFast / DurationBase / DurationSwitch / DurationPage 以
    <Duration x:Key="...">0:0:0.18</Duration> 形式声明（Duration 带 DurationConverter，
    支持以文本内容初始化），这样外部写成 Duration="{StaticResource MotionRelease}" 时
    拿到的就是 Duration 结构体本身，不需要隐式转换。
    若某个 WPF/.NET 版本的标记编译器不接受该写法，请改为
      xmlns:sys="clr-namespace:System;assembly=System.Runtime" 加
      <sys:TimeSpan x:Key="DurationBase">0:0:0.18</sys:TimeSpan>，
    或直接删除这四个键、在动画里写 Duration="{StaticResource MotionRelease}"（本文件内部动画已全部使用
    字面量时长，不依赖这四个键）。
  ===========================================================================
  动画实现要点（避免 Freezable 冻结异常）：
    · 主题画刷（SolidColorBrush 资源）会被冻结，绝不对它们做 Color 动画。
    · 轨道/底色的颜色过渡用两层叠加元素 + Opacity 动画实现，视觉与 Color 动画一致，
      且动画目标是 UIElement.Opacity（永不冻结）。
    · 滑块位移动画的路径为 (UIElement.RenderTransform).(TranslateTransform.X)。
    · 所有动画放在 ControlTemplate.Triggers 的 EnterActions / ExitActions 中，
      并给出值类型属性的静态 Setter 兜底（保证初始状态就正确）。
    · 不要用 Setter 去替换 RenderTransform 这类 Freezable 实例：替换会让正在运行的
      动画失去目标，位移动画会退化成瞬间跳变。
  ===========================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:app="clr-namespace:HowToFishTrainer.App">

  <!-- =======================================================================
       1. 调色板（既有令牌，色值一字不改）
       ======================================================================= -->
  <SolidColorBrush x:Key="BgBrush" Color="#F8F6FA" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FCFBFD" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="#466E7D" />
  <SolidColorBrush x:Key="AccentDarkBrush" Color="#32525E" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9EEF1" />
  <SolidColorBrush x:Key="GoldBrush" Color="#8C6A32" />
  <SolidColorBrush x:Key="TextBrush" Color="#251F2A" />
  <!-- 次文字：由 #776D7C 收到 #6F6575。依据是**合成后**的实测对比度（verification/polish/composited-contrast-audit.json），不是纸面换算：
       #776D7C 在玻璃底上会掉到 4.5:1 以下 —— 页头说明 3.73、禁用主按钮文字 4.14、等待态 4.46；
       #6F6575 在所有这些底色上都 >= 4.66，同时仍是同一色系的次级灰，与 TextBrush 的层次关系不变。 -->
  <SolidColorBrush x:Key="MutedBrush" Color="#6F6575" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#347B5C" />
  <SolidColorBrush x:Key="WarningBrush" Color="#95651F" />
  <SolidColorBrush x:Key="DangerBrush" Color="#B24C62" />
  <SolidColorBrush x:Key="LineBrush" Color="#DEE5E8" />

  <!-- =======================================================================
       1b. Liquid Glass 材质层与层级 token（新增，不改上面任何既有键的值）

       目标：借鉴 iOS 26/27 Liquid Glass 的「清透但可读、柔和圆角、有层次的表面」，
       在纯 WPF 里用受控底色 + 渐变着色 + 细边缘高光做出来，不使用 AllowsTransparency、
       不逐帧截屏、不把 BlurEffect 挂在含文字的整卡上。

       分层约定（自下而上）：
         GlassCanvasBrush  独立背景层，静态渐变 + 光晕，IsHitTestVisible=False
         GlassChromeBrush  顶栏/底部状态栏工具层——玻璃感最强
         GlassNavBrush     顶部导航带——其次
         GlassCardBrush    功能卡片——更实的磨砂面，保证长文本可读
         FieldBrush        输入框——最实（接近不透明白）
       边缘高光统一「上亮下柔」，光源方向一致，不在每张卡上放随机斑点。
       ======================================================================= -->

  <!-- 页面背景：极浅冷灰青渐变，比原纯色 #F8F6FA 多一点纵深 -->
  <LinearGradientBrush x:Key="GlassCanvasBrush" StartPoint="0,0" EndPoint="0.35,1">
    <GradientStop Color="#EDF3F7" Offset="0" />
    <GradientStop Color="#E5EDF2" Offset="0.55" />
    <GradientStop Color="#DDE7ED" Offset="1" />
  </LinearGradientBrush>

  <!-- 背景光晕：非常克制的低饱和冷色，只做层次，不形成彩色渐变 -->
  <RadialGradientBrush x:Key="GlassHaloAccentBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
    <GradientStop Color="#3D7FA3B4" Offset="0" />
    <GradientStop Color="#007FA3B4" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="GlassHaloWarmBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
    <GradientStop Color="#29C6B9A6" Offset="0" />
    <GradientStop Color="#00C9BCA8" Offset="1" />
  </RadialGradientBrush>

  <!-- 顶栏/底栏工具层：最通透的一层 -->
  <LinearGradientBrush x:Key="GlassChromeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F2FAFCFD" Offset="0" />
    <GradientStop Color="#E6F2F7FA" Offset="1" />
  </LinearGradientBrush>

  <!-- 导航带：介于工具层与内容层之间 -->
  <LinearGradientBrush x:Key="GlassNavBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EEF6FAFC" Offset="0" />
    <GradientStop Color="#DEF0F6F9" Offset="1" />
  </LinearGradientBrush>

  <!-- 玻璃面：卡片用更实的磨砂面，压住后面的背景，保证长说明文字可读。
       注意透明度只作用在这一层，文字用稳定不透明色，不做整卡 Opacity 降低。 -->
  <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EEFFFFFF" Offset="0" />
    <GradientStop Color="#E4F3F8FB" Offset="1" />
  </LinearGradientBrush>

  <!-- 边缘高光拆成两组描边画笔。
       注意：BorderBrush 是"描边"不是"填充"，所以这里必须是竖向渐变（上亮下柔），
       不能用 GlassEdgeBrush 那种带强白头的面渐变；否则 1px 描边会变成一条渐变实带，
       看起来像加粗的玻璃边。光源统一来自上方，不在每张卡上放随机斑点。 -->
  <LinearGradientBrush x:Key="GlassEdgeHBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#D9FFFFFF" Offset="0" />
    <GradientStop Color="#59A0B8C4" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdgeVBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#6BADC2CD" Offset="0" />
    <GradientStop Color="#4D9DB4C0" Offset="1" />
  </LinearGradientBrush>
  <!-- 顶栏/导航层的上边缘更亮一档，做出"浮动工具层"的光学边 -->
  <LinearGradientBrush x:Key="GlassEdgeChromeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#CCFFFFFF" Offset="0" />
    <GradientStop Color="#4DA6BCC7" Offset="1" />
  </LinearGradientBrush>

  <!-- 顶边镜面高光：这一条**不是描边，是面**（横向渐变，左侧最亮、向右收敛）。
       用途是把「光源在上方」这条统一光照约定再明确一档：描边画的是轮廓，
       镜面画的是"玻璃被光源扫到的那一条"。只在外壳与工具层最上沿用，
       不做成每张卡都有的随机斑点。 -->
  <LinearGradientBrush x:Key="GlassSpecularBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#B3FFFFFF" Offset="0" />
    <GradientStop Color="#66FFFFFF" Offset="0.42" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- 浮动选中胶囊的材质：比导航带再实一点，让"被选中的那一项"浮在导航之上。
       它是装饰层，IsHitTestVisible 由外层 Canvas 统一设为 False，不参与命中。 -->
  <LinearGradientBrush x:Key="GlassNavCapsuleBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EEFFFFFF" Offset="0" />
    <GradientStop Color="#E8F2F7FA" Offset="1" />
  </LinearGradientBrush>

  <!-- 玻璃面下方的柔和落影：比原来的 ShadowSoft 更淡更宽，避免"重黑边"观感 -->
  <DropShadowEffect x:Key="GlassShadowSoft" BlurRadius="12" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.075" RenderingBias="Performance" />
  <DropShadowEffect x:Key="GlassShadowRaised" BlurRadius="24" ShadowDepth="3" Direction="270"
                    Color="#3D5A6B78" Opacity="0.12" RenderingBias="Performance" />
  <!-- 顶栏/导航层用的极淡阴影，做出"浮动"而不脏 -->
  <DropShadowEffect x:Key="GlassShadowChrome" BlurRadius="18" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.07" RenderingBias="Performance" />

  <!-- 窗口外壳的高程落影。刻意与卡片阴影分开：外壳只有一处、要读成"整个面板浮起来"，
       卡片有 12 处、只需要极轻的层次。混用会把 12 张卡一起压重。
       参数按"必须完全落在 12 DIP 的外壳外边距里、不被窗口边缘硬裁"反推：
       BlurRadius 9（高斯 sigma≈4.5）+ ShadowDepth 2，在 12 DIP 处的剩余 alpha 已低于
       0.01，肉眼不可见，所以看不到被裁出来的硬边。
       外壳外边距刻意取小（12 DIP 而不是 24）：窗口最小尺寸是 1180×720，
       每边 12 已经要吃掉 2% 的内容宽度，再大会把顶部导航推到第三行。
       这不是"越糊越好"的取舍——外壳阴影要的是"有一条明确的分界"，
       所以宁可窄而清楚，也不要宽到被裁。 -->
  <DropShadowEffect x:Key="GlassShadowWindow" BlurRadius="9" ShadowDepth="2" Direction="270"
                    Color="#3D5A6B78" Opacity="0.18" RenderingBias="Performance" />

  <!-- 层级圆角：窗口 22 / 主容器 20 / 卡片 18 / 字段 11 / 胶囊按高度一半 -->
  <CornerRadius x:Key="RadiusWindow">22</CornerRadius>
  <CornerRadius x:Key="RadiusContainer">20</CornerRadius>
  <CornerRadius x:Key="RadiusCard">18</CornerRadius>
  <CornerRadius x:Key="RadiusField">11</CornerRadius>
  <!-- 控件级圆角。这三个原先是散落在各模板里的字面量（按钮 8 / 导航项 12 / 胶囊标签 16），
       收成令牌只是为了让"层级圆角"这一套说法在磁盘上真的成立，
       取值一个都没改，所以不会改变任何现有观感。 -->
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusNav">12</CornerRadius>
  <CornerRadius x:Key="RadiusChip">16</CornerRadius>
  <!-- RectangleGeometry.RadiusX/RadiusY 是 Double 而不是 CornerRadius，
       所以窗口圆角需要一份同值的 Double 形式给裁剪几何用。
       两者必须同值：改了 RadiusWindow 就要同时改这里，否则窗口轮廓与内容裁切会错位。
       当前都是 22。 -->
  <sys:Double x:Key="RadiusWindowSize">22</sys:Double>

  <!-- 间距节奏：4 / 8 / 12 / 16 / 24 / 32 -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space5">24</sys:Double>
  <sys:Double x:Key="Space6">32</sys:Double>

  <!-- 字号阶梯：页标题 26 / 分区 17 / 卡片标题 15 / 正文 12.5 / 辅助 11 -->
  <sys:Double x:Key="FontPage">26</sys:Double>
  <sys:Double x:Key="FontSection">17</sys:Double>
  <sys:Double x:Key="FontCardTitle">15</sys:Double>
  <sys:Double x:Key="FontBody">12.5</sys:Double>
  <sys:Double x:Key="FontCaption">11</sys:Double>

  <!-- 控件高度：一般字段/按钮 36，紧急停用入口不能过小 -->
  <sys:Double x:Key="ControlHeight">36</sys:Double>

  <!-- 禁用态不透明度。原先是 15 处各自硬编码的 0.42 —— 值一个都没改，
       收成令牌是为了让「禁用态到底多淡」有一个可审计的单点，
       也让禁用态过渡动画有一个统一的终值可以引用。

       配套约定：引用本令牌的 15 处禁用态 EnterActions（以及配对的 ExitActions 回 1）
       都写了 FillBehavior="Stop"。理由是这两条动画的终值与触发器的静态 Setter 兜底值
       **完全相等**（进入 = 0.42，退出 = 1），所以时钟结束即释放、属性回落到基值不会产生
       任何视觉跳变；反之若用默认的 HoldEnd，每一个"启动时就处于禁用态"的控件都会常驻一个
       时钟（实测 18 → 54）。这与 PageFadeIn 是同一条理由。
       注意：不是所有保持态都能这么处理 —— 导航项选中态 SelFill、失焦遮罩的终值
       **不等于**基值，必须靠 HoldEnd 维持，改成 Stop 会直接破坏该状态。 -->
  <sys:Double x:Key="DisabledOpacity">0.42</sys:Double>

  <!-- =======================================================================
       1c. Motion token：统一时长与缓动，不在各处散落随机数值
       既有缓动键（EaseSoft / EaseStandard / EaseSwitch / EaseEnter 等）在下面的
       动效令牌区声明并保持原值，这里只补新增的时长与一个克制的选中缓动。
       ======================================================================= -->
  <x:Static x:Key="MotionHover" Member="app:UiMotion.Hover"/>
  <x:Static x:Key="MotionPress" Member="app:UiMotion.Press"/>
  <x:Static x:Key="MotionRelease" Member="app:UiMotion.Release"/>
  <x:Static x:Key="MotionFocus" Member="app:UiMotion.Focus"/>
  <x:Static x:Key="MotionSelect" Member="app:UiMotion.Select"/>
  <x:Static x:Key="MotionPage" Member="app:UiMotion.Page"/>
  <x:Static x:Key="MotionSwitch" Member="app:UiMotion.Switch"/>
  <x:Static x:Key="MotionStatus" Member="app:UiMotion.Status"/>
  <x:Static x:Key="MotionExpand" Member="app:UiMotion.Expand"/>
  <x:Static x:Key="MotionPopup" Member="app:UiMotion.Popup"/>

  <!-- 给"移动的选中指示面"用的克制弹簧：过冲比 EaseSwitch 更小 -->
  <BackEase x:Key="EaseSelect" EasingMode="EaseOut" Amplitude="0.18" />


  <SolidColorBrush x:Key="HoverBrush" Color="#EFF4F6" />
  <SolidColorBrush x:Key="AccentWashBrush" Color="#F2F6F7" />
  <SolidColorBrush x:Key="AccentLineBrush" Color="#B9CDD5" />
  <!-- 激活窗口“赞助版”对比卡的浅底与边线（原为字面量，值未改，只是收成令牌） -->
  <SolidColorBrush x:Key="AccentTintBrush" Color="#F4F8F9" />
  <SolidColorBrush x:Key="AccentEdgeBrush" Color="#A8C3CC" />
  <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
  <!-- 输入框边线单独一档：白底白面时边线是唯一的边界线索，原 #B9CDD5 对白底只有 1.65:1。
       #96B0BB 是同一个色相向主色混 30% 得到的，对白底 2.28:1，明显看得清又不显得加粗。
       没有取到 WCAG 非文本 3:1 是有意的：3:1 需要 #7494A0 这种深度，会让 170 个输入框的
       边框整体变重，与「保留原有观感」冲突。此处按「明显改善 + 不改变整体气质」取舍。 -->
  <SolidColorBrush x:Key="FieldLineBrush" Color="#96B0BB" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EDF8F2" />
  <SolidColorBrush x:Key="SuccessLineBrush" Color="#CDE8D8" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF9EA" />
  <SolidColorBrush x:Key="WarningLineBrush" Color="#ECD9A8" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCE8EA" />
  <SolidColorBrush x:Key="DangerLineBrush" Color="#E8A6AE" />
  <!-- 面板内的次级填充/边线：原先散落在 MainWindow 里的字面量，值未改，只是收成令牌，
       避免同一颜色在多处各写一遍导致后续改色漏改。 -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#F1F5F7" />
  <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#D6E3E8" />
  <SolidColorBrush x:Key="FieldBorderBrush" Color="#D2E0E5" />
  <!-- 进度条轨道：比 AccentSoftBrush 略深，保证浅色面上仍能看清轨道范围 -->
  <SolidColorBrush x:Key="ProgressTrackBrush" Color="#EBEFF1" />
  <!-- 功能卡右上角状态胶囊的四态底色（原先硬编码在 MainWindow 的 DataTrigger 里） -->
  <SolidColorBrush x:Key="CardStateIdleBrush" Color="#EDF1F3" />
  <SolidColorBrush x:Key="CardStateWaitBrush" Color="#FFF0C8" />
  <!-- “已生效”用比 SuccessSoftBrush 更饱和一点的绿，保留原有层次差别 -->
  <SolidColorBrush x:Key="CardStateAppliedBrush" Color="#E6F4EC" />
  <!-- 小型“N 个”计数胶囊底色：比 HoverBrush 略深，保留原有层次差别 -->
  <SolidColorBrush x:Key="CardStateCountBrush" Color="#EDF2F4" />
  <SolidColorBrush x:Key="CardStateRiskBrush" Color="#FFFBFB" />
  <SolidColorBrush x:Key="CardStateRiskSoftBrush" Color="#FFF5EF" />

  <!-- =======================================================================
       2. 阴影（描边优先，阴影只做极轻层次）
       ======================================================================= -->
  <DropShadowEffect x:Key="CardShadow" Color="#22404A" BlurRadius="12" ShadowDepth="1" Opacity="0.09" />
  <DropShadowEffect x:Key="ShadowSoft" Color="#1F3A43" BlurRadius="8" ShadowDepth="1" Opacity="0.06" />
  <DropShadowEffect x:Key="ShadowRaised" Color="#1F3A43" BlurRadius="18" ShadowDepth="3" Opacity="0.13" />

  <!-- =======================================================================
       3. 共享动效资源（契约 §4）
       ======================================================================= -->
  <CubicEase x:Key="EaseStandard" EasingMode="EaseOut" />
  <CubicEase x:Key="EaseEnter" EasingMode="EaseOut" />
  <CubicEase x:Key="EaseExit" EasingMode="EaseIn" />
  <BackEase x:Key="EaseSwitch" Amplitude="0.28" EasingMode="EaseOut" />
  <QuadraticEase x:Key="EaseSoft" EasingMode="EaseInOut" />

  <Duration x:Key="DurationFast">0:0:0.15</Duration>
  <Duration x:Key="DurationBase">0:0:0.18</Duration>
  <Duration x:Key="DurationSwitch">0:0:0.22</Duration>
  <Duration x:Key="DurationPage">0:0:0.24</Duration>

  <!-- =======================================================================
       4. 焦点视觉：2px AccentBrush 描边（替代系统虚线框）
       · 圆角改成令牌 RadiusControl（原先写死 4）；FeatureSwitch 那种药丸控件用
         下面的 FocusRingPill（RadiusChip），不去把共用样式拉变形。
       · 画在 AdornerLayer 上：Margin="-2" 只向外扩，不参与布局、不改变控件测量尺寸；
         IsHitTestVisible=False 保证不吃命中。又因为它不在控件子树里，控件自身
         Opacity 掉到禁用态时，焦点环仍按 AccentBrush 全不透明绘制 ——
         这正是「禁用观感但可聚焦」的控件也要看得见焦点环所需要的。
       · 淡入用 MotionFocus + EaseEnter（MotionReduced 会把它归零）；
         静态兜底 Opacity=1，保证不播动画时焦点环依然可见。
         动画不写 Storyboard.TargetName：EventTrigger 的目标默认就是它所在的那个
         Border，避免模板名字域解析带来的风险。
       ======================================================================= -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2"
                  BorderBrush="{StaticResource AccentBrush}"
                  BorderThickness="2"
                  CornerRadius="{StaticResource RadiusControl}"
                  IsHitTestVisible="False"
                  Opacity="1"
