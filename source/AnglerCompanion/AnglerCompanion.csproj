<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWPF>true</UseWPF><TargetFramework>net8.0-windows</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AbyssalCrab.Angler</AssemblyName><RootNamespace>HowToFishTrainer.App</RootNamespace><LangVersion>12</LangVersion><Nullable>enable</Nullable>
    <Product>AbyssalCrab Studio · 钓鱼手记</Product><Description>本地钓鱼日志、图鉴、回顾与存档备份</Description><Version>1.0.0</Version>
    <ApplicationIcon>..\HowToFishTrainer\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="AnglerApp.xaml"/>
    <ApplicationDefinition Include="AnglerApp.xaml"/>
    <Compile Include="..\HowToFishTrainer\HowToFishTrainer\App\Fishing*.cs" Link="Journal\%(Filename)%(Extension)"/>
    <Compile Include="..\HowToFishTrainer\HowToFishTrainer\App\SaveBackupService.cs" Link="Journal\SaveBackupService.cs"/>
    <Compile Include="..\HowToFishTrainer\HowToFishTrainer\App\NumericInput.cs" Link="Journal\NumericInput.cs"/>
    <Compile Include="..\HowToFishTrainer\HowToFishTrainer\App\RelayCommand.cs" Link="Journal\RelayCommand.cs"/>
    <Compile Include="..\HowToFishTrainer\HowToFishTrainer\App\UiMotion.cs" Link="Journal\UiMotion.cs"/>
    <Compile Include="..\HowToFishTrainer\HowToFishTrainer\App\CardLiftTransform.cs" Link="Journal\CardLiftTransform.cs"/>
    <Page Include="..\HowToFishTrainer\HowToFishTrainer\App\FishingWindow.xaml" Link="Journal\FishingWindow.xaml"/>
    <Page Include="..\HowToFishTrainer\themes\theme.xaml" Link="Themes\Theme.xaml"/>
    <Page Include="..\HowToFishTrainer\themes\MaterialTinted.xaml" Link="Themes\MaterialTinted.xaml"/>
    <Page Include="..\HowToFishTrainer\themes\MaterialSolid.xaml" Link="Themes\MaterialSolid.xaml"/>
    <Page Include="..\HowToFishTrainer\themes\MotionReduced.xaml" Link="Themes\MotionReduced.xaml"/>
  </ItemGroup>
</Project>
